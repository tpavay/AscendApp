rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // RevenueCat is reconciled into a server-owned active-grant document.
    // Existence deliberately replaces the old signed-in predicate instead of
    // adding another expression: valid workouts already consume Firestore's
    // 1000-expression evaluation ceiling.
    function hasPaidAppAccess() {
      return exists(
        /databases/$(database)/documents/users/$(request.auth.uid)/entitlements/app_access
      );
    }

    function isPaidOwner(userId) {
      return request.auth.uid == userId &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/entitlements/app_access
        );
    }

    function isNonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    // A schema version is metadata, not a trust boundary - every field of every
    // versioned document is validated by type and domain independently of this
    // number, so narrowing it buys no safety and costs availability. Pinning it
    // to one exact value locks documents and clients out in both directions the
    // day the number moves: stored documents at the old version stop being
    // updatable by an updated client, and clients still on the old build stop
    // being able to write at all. Rules deploy globally and instantly while app
    // rollout is gradual, so the two can never be ordered to avoid that. The
    // floor is 1 because no shipped client ever emitted a lower number; the
    // ceiling is only a garbage guard, matching contextVersion / rulesVersion.
    function isSupportedSchemaVersion(version) {
      return version is int &&
        version >= 1 &&
        version <= 1000;
    }

    function isValidLocationProfileText(value) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= 120;
    }

    // Case, diacritic, and confusable-letter folding only. Digits stay digits
    // so the repeated-character check cannot invent a letter run out of an
    // ordinary numeric name like "Climber2000".
    function foldedDisplayName(value) {
      return value
        .replace("[ªÀÁÂÃÄÅàáâãäåĀāĂăĄąǍǎǞǟǠǡǺǻȀȁȂȃȦȧᴬᵃḀḁẚẠạẢảẤấẦầẨẩẪẫẬậẮắẰằẲẳẴẵẶặₐÅＡａ𝐀𝐚𝐴𝑎𝑨𝒂𝒜𝒶𝓐𝓪𝔄𝔞𝔸𝕒𝕬𝖆𝖠𝖺𝗔𝗮𝘈𝘢𝘼𝙖𝙰𝚊]", "a")
        .replace("[ᴮᵇḂḃḄḅḆḇℬＢｂ𝐁𝐛𝐵𝑏𝑩𝒃𝒷𝓑𝓫𝔅𝔟𝔹𝕓𝕭𝖇𝖡𝖻𝗕𝗯𝘉𝘣𝘽𝙗𝙱𝚋]", "b")
        .replace("[ÇçĆćĈĉĊċČčᶜḈḉℂℭꟲＣｃ𝐂𝐜𝐶𝑐𝑪𝒄𝒞𝒸𝓒𝓬𝔠𝕔𝕮𝖈𝖢𝖼𝗖𝗰𝘊𝘤𝘾𝙘𝙲𝚌]", "c")
        .replace("[ĎďᴰᵈḊḋḌḍḎḏḐḑḒḓⅅⅆＤｄ𝐃𝐝𝐷𝑑𝑫𝒅𝒟𝒹𝓓𝓭𝔇𝔡𝔻𝕕𝕯𝖉𝖣𝖽𝗗𝗱𝘋𝘥𝘿𝙙𝙳𝚍]", "d")
        .replace("[ÈÉÊËèéêëĒēĔĕĖėĘęĚěȄȅȆȇȨȩᴱᵉḔḕḖḗḘḙḚḛḜḝẸẹẺẻẼẽẾếỀềỂểỄễỆệₑℯℰⅇＥｅ𝐄𝐞𝐸𝑒𝑬𝒆𝓔𝓮𝔈𝔢𝔼𝕖𝕰𝖊𝖤𝖾𝗘𝗲𝘌𝘦𝙀𝙚𝙴𝚎]", "e")
        .replace("[ᶠḞḟℱꟳＦｆ𝐅𝐟𝐹𝑓𝑭𝒇𝒻𝓕𝓯𝔉𝔣𝔽𝕗𝕱𝖋𝖥𝖿𝗙𝗳𝘍𝘧𝙁𝙛𝙵𝚏]", "f")
        .replace("[ĜĝĞğĠġĢģǦǧǴǵᴳᵍḠḡℊＧｇ𝐆𝐠𝐺𝑔𝑮𝒈𝒢𝓖𝓰𝔊𝔤𝔾𝕘𝕲𝖌𝖦𝗀𝗚𝗴𝘎𝘨𝙂𝙜𝙶𝚐]", "g")
        .replace("[ĤĥȞȟʰᴴḢḣḤḥḦḧḨḩḪḫẖₕℋℌℍℎＨｈ𝐇𝐡𝐻𝑯𝒉𝒽𝓗𝓱𝔥𝕙𝕳𝖍𝖧𝗁𝗛𝗵𝘏𝘩𝙃𝙝𝙷𝚑]", "h")
        .replace("[ÌÍÎÏìíîïĨĩĪīĬĭĮįİǏǐȈȉȊȋᴵᵢḬḭḮḯỈỉỊịⁱℐℑℹⅈＩｉ𝐈𝐢𝐼𝑖𝑰𝒊𝒾𝓘𝓲𝔦𝕀𝕚𝕴𝖎𝖨𝗂𝗜𝗶𝘐𝘪𝙄𝙞𝙸𝚒]", "i")
        .replace("[ĴĵǰʲᴶⅉⱼＪｊ𝐉𝐣𝐽𝑗𝑱𝒋𝒥𝒿𝓙𝓳𝔍𝔧𝕁𝕛𝕵𝖏𝖩𝗃𝗝𝗷𝘑𝘫𝙅𝙟𝙹𝚓]", "j")
        .replace("[ĶķǨǩᴷᵏḰḱḲḳḴḵₖＫｋ𝐊𝐤𝐾𝑘𝑲𝒌𝒦𝓀𝓚𝓴𝔎𝔨𝕂𝕜𝕶𝖐𝖪𝗄𝗞𝗸𝘒𝘬𝙆𝙠𝙺𝚔]", "k")
        .replace("[ĹĺĻļĽľĿŀˡᴸḶḷḸḹḺḻḼḽₗℒℓＬｌ𝐋𝐥𝐿𝑙𝑳𝒍𝓁𝓛𝓵𝔏𝔩𝕃𝕝𝕷𝖑𝖫𝗅𝗟𝗹𝘓𝘭𝙇𝙡𝙻𝚕]", "l")
        .replace("[ᴹᵐḾḿṀṁṂṃₘℳＭｍ𝐌𝐦𝑀𝑚𝑴𝒎𝓂𝓜𝓶𝔐𝔪𝕄𝕞𝕸𝖒𝖬𝗆𝗠𝗺𝘔𝘮𝙈𝙢𝙼𝚖]", "m")
        .replace("[ÑñŃńŅņŇňŉǸǹᴺṄṅṆṇṈṉṊṋⁿₙℕＮｎ𝐍𝐧𝑁𝑛𝑵𝒏𝒩𝓃𝓝𝓷𝔑𝔫𝕟𝕹𝖓𝖭𝗇𝗡𝗻𝘕𝘯𝙉𝙣𝙽𝚗]", "n")
        .replace("[ºÒÓÔÕÖòóôõöŌōŎŏŐőƠơǑǒǪǫǬǭȌȍȎȏȪȫȬȭȮȯȰȱᴼᵒṌṍṎṏṐṑṒṓỌọỎỏỐốỒồỔổỖỗỘộỚớỜờỞởỠỡỢợₒℴＯｏ𝐎𝐨𝑂𝑜𝑶𝒐𝒪𝓞𝓸𝔒𝔬𝕆𝕠𝕺𝖔𝖮𝗈𝗢𝗼𝘖𝘰𝙊𝙤𝙾𝚘]", "o")
        .replace("[ᴾᵖṔṕṖṗₚℙＰｐ𝐏𝐩𝑃𝑝𝑷𝒑𝒫𝓅𝓟𝓹𝔓𝔭𝕡𝕻𝖕𝖯𝗉𝗣𝗽𝘗𝘱𝙋𝙥𝙿𝚙]", "p")
        .replace("[ℚꟴＱｑ𐞥𝐐𝐪𝑄𝑞𝑸𝒒𝒬𝓆𝓠𝓺𝔔𝔮𝕢𝕼𝖖𝖰𝗊𝗤𝗾𝘘𝘲𝙌𝙦𝚀𝚚]", "q")
        .replace("[ŔŕŖŗŘřȐȑȒȓʳᴿᵣṘṙṚṛṜṝṞṟℛℜℝＲｒ𝐑𝐫𝑅𝑟𝑹𝒓𝓇𝓡𝓻𝔯𝕣𝕽𝖗𝖱𝗋𝗥𝗿𝘙𝘳𝙍𝙧𝚁𝚛]", "r")
        .replace("[ŚśŜŝŞşŠšſȘșˢṠṡṢṣṤṥṦṧṨṩẛₛ꟱Ｓｓ𝐒𝐬𝑆𝑠𝑺𝒔𝒮𝓈𝓢𝓼𝔖𝔰𝕊𝕤𝕾𝖘𝖲𝗌𝗦𝘀𝘚𝘴𝙎𝙨𝚂𝚜]", "s")
        .replace("[ŢţŤťȚțᵀᵗṪṫṬṭṮṯṰṱẗₜＴｔ𝐓𝐭𝑇𝑡𝑻𝒕𝒯𝓉𝓣𝓽𝔗𝔱𝕋𝕥𝕿𝖙𝖳𝗍𝗧𝘁𝘛𝘵𝙏𝙩𝚃𝚝]", "t")
        .replace("[ÙÚÛÜùúûüŨũŪūŬŭŮůŰűŲųƯưǓǔǕǖǗǘǙǚǛǜȔȕȖȗᵁᵘᵤṲṳṴṵṶṷṸṹṺṻỤụỦủỨứỪừỬửỮữỰựＵｕ𝐔𝐮𝑈𝑢𝑼𝒖𝒰𝓊𝓤𝓾𝔘𝔲𝕌𝕦𝖀𝖚𝖴𝗎𝗨𝘂𝘜𝘶𝙐𝙪𝚄𝚞]", "u")
        .replace("[ᵛᵥṼṽṾṿⱽＶｖ𝐕𝐯𝑉𝑣𝑽𝒗𝒱𝓋𝓥𝓿𝔙𝔳𝕍𝕧𝖁𝖛𝖵𝗏𝗩𝘃𝘝𝘷𝙑𝙫𝚅𝚟]", "v")
        .replace("[ŴŵʷᵂẀẁẂẃẄẅẆẇẈẉẘＷｗ𝐖𝐰𝑊𝑤𝑾𝒘𝒲𝓌𝓦𝔀𝔚𝔴𝕎𝕨𝖂𝖜𝖶𝗐𝗪𝘄𝘞𝘸𝙒𝙬𝚆𝚠]", "w")
        .replace("[ˣẊẋẌẍₓＸｘ𝐗𝐱𝑋𝑥𝑿𝒙𝒳𝓍𝓧𝔁𝔛𝔵𝕏𝕩𝖃𝖝𝖷𝗑𝗫𝘅𝘟𝘹𝙓𝙭𝚇𝚡]", "x")
        .replace("[ÝýÿŶŷŸȲȳʸẎẏẙỲỳỴỵỶỷỸỹＹｙ𝐘𝐲𝑌𝑦𝒀𝒚𝒴𝓎𝓨𝔂𝔜𝔶𝕐𝕪𝖄𝖞𝖸𝗒𝗬𝘆𝘠𝘺𝙔𝙮𝚈𝚢]", "y")
        .replace("[ŹźŻżŽžᶻẐẑẒẓẔẕℤℨＺｚ𝐙𝐳𝑍𝑧𝒁𝒛𝒵𝓏𝓩𝔃𝔷𝕫𝖅𝖟𝖹𝗓𝗭𝘇𝘡𝘻𝙕𝙯𝚉𝚣]", "z")
        .replace("[Ĳĳ]", "ij")
        .replace("[ǄǅǆǱǲǳ]", "dz")
        .replace("[Ǉǈǉ]", "lj")
        .replace("[Ǌǋǌ]", "nj")
        .replace("ﬀ", "ff")
        .replace("ﬁ", "fi")
        .replace("ﬂ", "fl")
        .replace("ﬃ", "ffi")
        .replace("ﬄ", "ffl")
        .replace("[ﬅﬆ]", "st")
        .lower()
        .replace("[аɑα]", "a")
        .replace("β", "b")
        .replace("[еёε]", "e")
        .replace("[іӏι]", "i")
        .replace("κ", "k")
        .replace("[оο]", "o")
        .replace("[рρ]", "p")
        .replace("с", "c")
        .replace("τ", "t")
        .replace("υ", "u")
        .replace("[хχ]", "x")
        .replace("у", "y")
        .replace("ս", "u");
    }

    // Leetspeak folding, applied only to the blocked-term checks.
    function digitSubstitutedDisplayName(folded) {
      return folded
        .replace("0", "o")
        .replace("1", "i")
        .replace("3", "e")
        .replace("4", "a")
        .replace("5", "s")
        .replace("7", "t")
        .replace("@", "a")
        .replace("\\$", "s")
        .replace("!", "i");
    }

    // Every viewer's device fetches this URL. Constrain it to a Firebase
    // Storage download URL so a modified client cannot point the whole
    // leaderboard at a host it controls. Mirrors validPhotoURL in
    // functions/src/publicIdentity.ts. The optional :443 is the default port
    // the Firebase iOS SDK leaves in every download URL it emits.
    function isValidPublicPhotoURL(value) {
      return value is string &&
        value.size() <= 2048 &&
        (value == "" ||
          value.matches(
            "^https://firebasestorage\\.googleapis\\.com(:443)?/v0/b/" +
            "[a-zA-Z0-9][a-zA-Z0-9._-]*/o/[^/]+$"
          ));
    }

    function hasVisibleDisplayName(value) {
      return value is string &&
        value.trim().size() > 0 &&
        !value.matches("^[\\s]*$");
    }

    function hasUnsupportedCompatibilityDisplayNameGlyph(value) {
      return value.matches(
        ".*[ʰ-ʺʽ-˿ᴀ-ᵿ⁰-₟℀-↏①-⓿㈀-㏿ﬀ-ﬆ︐-﹫＀-￯𝐀-𝟿🄀-🋿].*"
      );
    }

    function isAllowedDisplayName(value) {
      let folded = foldedDisplayName(value);
      let normalized = digitSubstitutedDisplayName(folded);
      return value is string &&
        value.size() <= 80 &&
        (value.size() == 0 || hasVisibleDisplayName(value)) &&
        !hasUnsupportedCompatibilityDisplayNameGlyph(value) &&
        !normalized.matches(
          "^[^a-z]*a[^a-z]*n[^a-z]*o[^a-z]*n[^a-z]*y[^a-z]*m[^a-z]*o[^a-z]*u[^a-z]*s" +
          "[^a-z]*c[^a-z]*l[^a-z]*i[^a-z]*m[^a-z]*b[^a-z]*e[^a-z]*r[^a-z]*$"
        ) &&
        !folded.matches(
          ".*(" +
          "a{3,}|b{3,}|c{3,}|d{3,}|e{3,}|f{3,}|g{3,}|" +
          "h{3,}|i{3,}|j{3,}|k{3,}|l{3,}|m{3,}|n{3,}|" +
          "o{3,}|p{3,}|q{3,}|r{3,}|s{3,}|t{3,}|u{3,}|" +
          "v{3,}|w{3,}|x{3,}|y{3,}|z{3,}" +
          ").*"
        ) &&
        !normalized.matches(
          "(^|.*[^a-z])(" +
          "a[^a-z]*s[^a-z]*s[^a-z]*h[^a-z]*o[^a-z]*l[^a-z]*e|" +
          "b[^a-z]*a[^a-z]*s[^a-z]*t[^a-z]*a[^a-z]*r[^a-z]*d|" +
          "b[^a-z]*i[^a-z]*t[^a-z]*c[^a-z]*h|" +
          "b[^a-z]*l[^a-z]*o[^a-z]*w[^a-z]*j[^a-z]*o[^a-z]*b|" +
          "c[^a-z]*h[^a-z]*i[^a-z]*n[^a-z]*k|" +
          "c[^a-z]*o[^a-z]*c[^a-z]*k|" +
          "c[^a-z]*u[^a-z]*n[^a-z]*t|" +
          "d[^a-z]*i[^a-z]*c[^a-z]*k|" +
          "d[^a-z]*o[^a-z]*u[^a-z]*c[^a-z]*h[^a-z]*e[^a-z]*b[^a-z]*a[^a-z]*g|" +
          "d[^a-z]*y[^a-z]*k[^a-z]*e|" +
          "f[^a-z]*a[^a-z]*g|" +
          "f[^a-z]*a[^a-z]*g[^a-z]*g[^a-z]*o[^a-z]*t|" +
          "f[^a-z]*u[^a-z]*c[^a-z]*k|" +
          "f[^a-z]*u[^a-z]*c[^a-z]*k[^a-z]*e[^a-z]*r|" +
          "f[^a-z]*u[^a-z]*c[^a-z]*k[^a-z]*i[^a-z]*n[^a-z]*g|" +
          "h[^a-z]*e[^a-z]*i[^a-z]*l[^a-z]*h[^a-z]*i[^a-z]*t[^a-z]*l[^a-z]*e[^a-z]*r|" +
          "h[^a-z]*i[^a-z]*t[^a-z]*l[^a-z]*e[^a-z]*r|" +
          "j[^a-z]*a[^a-z]*c[^a-z]*k[^a-z]*a[^a-z]*s[^a-z]*s|" +
          "k[^a-z]*i[^a-z]*k[^a-z]*e|" +
          "k[^a-z]*i[^a-z]*l[^a-z]*l[^a-z]*y[^a-z]*o[^a-z]*u[^a-z]*r[^a-z]*s[^a-z]*e[^a-z]*l[^a-z]*f|" +
          "m[^a-z]*o[^a-z]*t[^a-z]*h[^a-z]*e[^a-z]*r[^a-z]*f[^a-z]*u[^a-z]*c[^a-z]*k[^a-z]*e[^a-z]*r|" +
          "n[^a-z]*a[^a-z]*z[^a-z]*i|" +
          "n[^a-z]*i[^a-z]*g[^a-z]*g[^a-z]*a|" +
          "n[^a-z]*i[^a-z]*g[^a-z]*g[^a-z]*e[^a-z]*r|" +
          "p[^a-z]*e[^a-z]*d[^a-z]*o|" +
          "p[^a-z]*e[^a-z]*d[^a-z]*o[^a-z]*p[^a-z]*h[^a-z]*i[^a-z]*l[^a-z]*e|" +
          "p[^a-z]*i[^a-z]*s[^a-z]*s|" +
          "p[^a-z]*u[^a-z]*s[^a-z]*s[^a-z]*y|" +
          "r[^a-z]*a[^a-z]*p[^a-z]*e|" +
          "r[^a-z]*a[^a-z]*p[^a-z]*i[^a-z]*s[^a-z]*t|" +
          "r[^a-z]*e[^a-z]*t[^a-z]*a[^a-z]*r[^a-z]*d|" +
          "r[^a-z]*e[^a-z]*t[^a-z]*a[^a-z]*r[^a-z]*d[^a-z]*e[^a-z]*d|" +
          "s[^a-z]*h[^a-z]*i[^a-z]*t|" +
          "s[^a-z]*l[^a-z]*u[^a-z]*t|" +
          "s[^a-z]*p[^a-z]*i[^a-z]*c|" +
          "w[^a-z]*e[^a-z]*t[^a-z]*b[^a-z]*a[^a-z]*c[^a-z]*k|" +
          "w[^a-z]*h[^a-z]*o[^a-z]*r[^a-z]*e|" +
          "w[^a-z]*h[^a-z]*i[^a-z]*t[^a-z]*e[^a-z]*p[^a-z]*o[^a-z]*w[^a-z]*e[^a-z]*r" +
          ")([^a-z].*|$)"
        ) &&
        !normalized.matches(
          ".*(" +
          "f[^a-z]*a[^a-z]*g[^a-z]*g[^a-z]*o[^a-z]*t|" +
          "f[^a-z]*u[^a-z]*c[^a-z]*k|" +
          "f[^a-z]*u[^a-z]*c[^a-z]*k[^a-z]*e[^a-z]*r|" +
          "n[^a-z]*i[^a-z]*g[^a-z]*g[^a-z]*e[^a-z]*r|" +
          "p[^a-z]*e[^a-z]*d[^a-z]*o[^a-z]*p[^a-z]*h[^a-z]*i[^a-z]*l[^a-z]*e" +
          ").*"
        );
    }

    function isValidUserDocument() {
      return request.resource.data.keys().hasOnly([
          "email",
          "firstName",
          "lastName",
          "displayName",
          "profilePictureURL",
          "age",
          "birth_date",
          "gender",
          "weight_kg",
          "height_cm",
          "location_city",
          "location_country",
          "location_region",
          "onboarding_first_climb_id",
          "joined_at",
          "createdAt",
          "lastUpdated"
        ]) &&
        request.resource.data.keys().hasAll([
          "email",
          "firstName",
          "lastName",
          "displayName",
          "createdAt",
          "lastUpdated"
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.firstName is string &&
        request.resource.data.firstName.size() <= 80 &&
        request.resource.data.lastName is string &&
        request.resource.data.lastName.size() <= 80 &&
        isAllowedDisplayName(request.resource.data.displayName) &&
        (!request.resource.data.keys().hasAny(["profilePictureURL"]) ||
          (request.resource.data.profilePictureURL is string &&
            request.resource.data.profilePictureURL.size() <= 2048)) &&
        (!request.resource.data.keys().hasAny(["age"]) ||
          (request.resource.data.age is int &&
            request.resource.data.age >= 13 &&
            request.resource.data.age <= 120)) &&
        (!request.resource.data.keys().hasAny(["birth_date"]) ||
          (request.resource.data.birth_date is string &&
            request.resource.data.birth_date.matches(
              "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$") &&
            int(request.resource.data.birth_date.split("-")[0]) <=
              request.time.year() - 13 &&
            int(request.resource.data.birth_date.split("-")[0]) >=
              request.time.year() - 121)) &&
        (!request.resource.data.keys().hasAny(["gender"]) ||
          (request.resource.data.gender is string &&
            request.resource.data.gender in [
              "woman",
              "man",
              "non_binary",
              "prefer_not_to_say"
            ])) &&
        (!request.resource.data.keys().hasAny(["weight_kg"]) ||
          (isNonNegativeNumber(request.resource.data.weight_kg) &&
            request.resource.data.weight_kg <= 400)) &&
        (!request.resource.data.keys().hasAny(["height_cm"]) ||
          (isNonNegativeNumber(request.resource.data.height_cm) &&
            request.resource.data.height_cm >= 90 &&
            request.resource.data.height_cm <= 240)) &&
        (!request.resource.data.keys().hasAny(["location_city"]) ||
          isValidLocationProfileText(request.resource.data.location_city)) &&
        (!request.resource.data.keys().hasAny(["location_country"]) ||
          (request.resource.data.location_country is string &&
            request.resource.data.location_country.matches("^[A-Z]{2}$"))) &&
        (!request.resource.data.keys().hasAny(["location_region"]) ||
          isValidLocationProfileText(request.resource.data.location_region)) &&
        (!request.resource.data.keys().hasAny(["onboarding_first_climb_id"]) ||
          (request.resource.data.onboarding_first_climb_id is string &&
            request.resource.data.onboarding_first_climb_id.size() > 0 &&
            request.resource.data.onboarding_first_climb_id.size() <= 160)) &&
        (!request.resource.data.keys().hasAny(["joined_at"]) ||
          request.resource.data.joined_at is timestamp) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.lastUpdated is timestamp;
    }

    function isValidClimbTier(tier) {
      return tier in [
        "common",
        "bronze",
        "silver",
        "gold",
        "diamond",
        "epic",
        "legendary",
        "mythic"
      ];
    }

    function isValidPublicProfileDocument(userId) {
      return request.resource.data.keys().hasOnly([
          "userId",
          "displayName",
          "photoURL",
          "identityPolicyVersion",
          "identityChangedAt",
          "age",
          "gender",
          "weight_kg",
          "height_cm",
          "location_city",
          "location_country",
          "location_region",
          "joined_at",
          "lastUpdated"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "displayName",
          "photoURL",
          "identityPolicyVersion",
          "identityChangedAt",
          "lastUpdated"
        ]) &&
        request.resource.data.userId == userId &&
        hasVisibleDisplayName(request.resource.data.displayName) &&
        isAllowedDisplayName(request.resource.data.displayName) &&
        isValidPublicPhotoURL(request.resource.data.photoURL) &&
        isValidIdentityPolicyMetadata() &&
        (!request.resource.data.keys().hasAny(["age"]) ||
          (request.resource.data.age is int &&
            request.resource.data.age >= 13 &&
            request.resource.data.age <= 120)) &&
        (!request.resource.data.keys().hasAny(["gender"]) ||
          (request.resource.data.gender is string &&
            request.resource.data.gender in [
              "woman",
              "man",
              "non_binary",
              "prefer_not_to_say"
            ])) &&
        (!request.resource.data.keys().hasAny(["weight_kg"]) ||
          (isNonNegativeNumber(request.resource.data.weight_kg) &&
            request.resource.data.weight_kg <= 400)) &&
        (!request.resource.data.keys().hasAny(["height_cm"]) ||
          (isNonNegativeNumber(request.resource.data.height_cm) &&
            request.resource.data.height_cm >= 90 &&
            request.resource.data.height_cm <= 240)) &&
        (!request.resource.data.keys().hasAny(["location_city"]) ||
          isValidLocationProfileText(request.resource.data.location_city)) &&
        (!request.resource.data.keys().hasAny(["location_country"]) ||
          (request.resource.data.location_country is string &&
            request.resource.data.location_country.matches("^[A-Z]{2}$"))) &&
        (!request.resource.data.keys().hasAny(["location_region"]) ||
          isValidLocationProfileText(request.resource.data.location_region)) &&
        (!request.resource.data.keys().hasAny(["joined_at"]) ||
          request.resource.data.joined_at is timestamp) &&
        request.resource.data.lastUpdated is timestamp;
    }

    function currentIdentityPolicyVersion() {
      return 1;
    }

    // Unlike a schemaVersion (see isSupportedSchemaVersion), this one is pinned
    // to an exact value on purpose: it asserts which moderation policy screened
    // the display name, so accepting an older value would accept weaker
    // screening. It is a trust boundary, not metadata - do not widen it.
    function isValidIdentityPolicyMetadata() {
      return request.resource.data.identityPolicyVersion is int &&
        request.resource.data.identityPolicyVersion ==
          currentIdentityPolicyVersion() &&
        request.resource.data.identityChangedAt is timestamp;
    }

    function isValidIdentityPolicyCreate() {
      return isValidIdentityPolicyMetadata() &&
        request.resource.data.identityChangedAt == request.time;
    }

    function isValidIdentityPolicyUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let identityChanged = changed.hasAny(["displayName", "photoURL"]);
      let metadataChanged = changed.hasAny([
        "identityPolicyVersion",
        "identityChangedAt"
      ]);
      return isValidIdentityPolicyMetadata() &&
        (
          (
            identityChanged &&
            request.resource.data.identityChangedAt == request.time &&
            (
              !resource.data.keys().hasAll([
                "identityPolicyVersion",
                "identityChangedAt"
              ]) ||
              (
                resource.data.identityChangedAt is timestamp &&
                request.resource.data.identityChangedAt >
                  resource.data.identityChangedAt
              )
            )
          ) ||
          (
            !identityChanged &&
            (
              !metadataChanged ||
              (
                request.resource.data.identityChangedAt == request.time &&
                (
                  !resource.data.keys().hasAll([
                    "identityPolicyVersion",
                    "identityChangedAt"
                  ]) ||
                  (
                    resource.data.identityChangedAt is timestamp &&
                    request.resource.data.identityChangedAt >
                      resource.data.identityChangedAt
                  )
                )
              )
            )
          )
        );
    }

    function isValidProfileStatsDocument() {
      return request.resource.data.keys().hasOnly([
          "total_climbs_completed",
          "total_first_ascents",
          "lifetime_total_steps",
          "lifetime_duration_seconds",
          "total_climbs",
          "average_steps_per_minute",
          "top_1_finishes",
          "top_3_finishes",
          "top_10_finishes",
          "top_100_finishes",
          "most_completed_climb_id",
          "current_streak_weeks",
          "best_streak_weeks",
          "pr_most_steps",
          "pr_longest_climb_seconds",
          "pr_highest_spm",
          "lastUpdated"
        ]) &&
        request.resource.data.keys().hasAll([
          "total_climbs_completed",
          "total_first_ascents",
          "lifetime_total_steps",
          "lifetime_duration_seconds",
          "total_climbs",
          "average_steps_per_minute",
          "top_1_finishes",
          "top_3_finishes",
          "top_10_finishes",
          "top_100_finishes",
          "most_completed_climb_id",
          "current_streak_weeks",
          "best_streak_weeks",
          "pr_most_steps",
          "pr_longest_climb_seconds",
          "pr_highest_spm",
          "lastUpdated"
        ]) &&
        request.resource.data.total_climbs_completed is int &&
        request.resource.data.total_climbs_completed >= 0 &&
        request.resource.data.total_first_ascents is int &&
        request.resource.data.total_first_ascents >= 0 &&
        request.resource.data.lifetime_total_steps is int &&
        request.resource.data.lifetime_total_steps >= 0 &&
        request.resource.data.lifetime_duration_seconds is int &&
        request.resource.data.lifetime_duration_seconds >= 0 &&
        request.resource.data.total_climbs is int &&
        request.resource.data.total_climbs >= 0 &&
        isNonNegativeNumber(request.resource.data.average_steps_per_minute) &&
        request.resource.data.top_1_finishes is int &&
        request.resource.data.top_1_finishes >= 0 &&
        request.resource.data.top_3_finishes is int &&
        request.resource.data.top_3_finishes >= request.resource.data.top_1_finishes &&
        request.resource.data.top_10_finishes is int &&
        request.resource.data.top_10_finishes >= request.resource.data.top_3_finishes &&
        request.resource.data.top_100_finishes is int &&
        request.resource.data.top_100_finishes >= request.resource.data.top_10_finishes &&
        request.resource.data.most_completed_climb_id is string &&
        request.resource.data.most_completed_climb_id.size() <= 160 &&
        request.resource.data.current_streak_weeks is int &&
        request.resource.data.current_streak_weeks >= 0 &&
        request.resource.data.best_streak_weeks is int &&
        request.resource.data.best_streak_weeks >= request.resource.data.current_streak_weeks &&
        request.resource.data.pr_most_steps is int &&
        request.resource.data.pr_most_steps >= 0 &&
        request.resource.data.pr_longest_climb_seconds is int &&
        request.resource.data.pr_longest_climb_seconds >= 0 &&
        isNonNegativeNumber(request.resource.data.pr_highest_spm) &&
        request.resource.data.lastUpdated is timestamp;
    }

    function isValidProfileWorkoutSummary() {
      return request.resource.data.keys().hasOnly([
          "name",
          "startedAt",
          "durationSeconds",
          "steps",
          "source",
          "climbId",
          "climbTier",
          "climbCompletionStatus",
          "climbCompletionDurationSeconds",
          "lastUpdated"
        ]) &&
        request.resource.data.keys().hasAll([
          "name",
          "startedAt",
          "durationSeconds",
          "steps",
          "source",
          "lastUpdated"
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.startedAt is timestamp &&
        isNonNegativeNumber(request.resource.data.durationSeconds) &&
        request.resource.data.steps is int &&
        request.resource.data.steps >= 0 &&
        isValidWorkoutSource(request.resource.data.source) &&
        (!request.resource.data.keys().hasAny(["climbId"]) ||
          (request.resource.data.climbId is string &&
            request.resource.data.climbId.size() > 0 &&
            request.resource.data.climbId.size() <= 160)) &&
        (!request.resource.data.keys().hasAny(["climbTier"]) ||
          isValidClimbTier(request.resource.data.climbTier)) &&
        (!request.resource.data.keys().hasAny(["climbCompletionStatus"]) ||
          isValidClimbAttemptStatus(request.resource.data.climbCompletionStatus)) &&
        (!request.resource.data.keys().hasAny(["climbCompletionDurationSeconds"]) ||
          (request.resource.data.climbCompletionDurationSeconds is int &&
            request.resource.data.climbCompletionDurationSeconds >= 0)) &&
        request.resource.data.lastUpdated is timestamp;
    }

    function isValidFeedbackType(type) {
      return type in ["feature_request", "bug_report", "get_help"];
    }

    // Enum validators take the value untyped: membership in a list of string
    // literals already excludes every non-string, so a preceding `is string`
    // check is a no-op the workout write rule has no expression budget for.
    function isValidWorkoutSource(source) {
      return source in [
        "manual",
        "apple_health",
        "garmin",
        "fitbit",
        "hevy",
        "headphone_motion"
      ];
    }

    function isValidClimbAttemptStatus(status) {
      return status in ["active", "completed", "failed", "abandoned"];
    }

    function isValidIntegrityLevel(level) {
      return level in ["verified", "unverified"];
    }

    // A workout document id has exactly one spelling: the uppercase UUID string. Any other
    // casing creates a second document for the same workout, so the server rejects it.
    function isCanonicalWorkoutId(workoutId) {
      return workoutId.matches("^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$");
    }

    // How many participations one workout may back up.
    //
    // Four, and four is the whole story: it is what this rule can actually evaluate, it is what
    // the rule declares, and it is what `WorkoutRemoteSyncLimits.maximumParticipations` refuses to
    // exceed on the writing side. The three used to disagree. The rule said eight, could evaluate
    // one, and the client emitted however many it had - so the ceiling moved depending on which
    // *other* optional fields a workout happened to carry, and the failure arrived as a bare
    // PERMISSION_DENIED with no way to tell a refusal from an abort (ASCEND-IOS-1J).
    //
    // Today nothing can reach even two: `WorkoutParticipationService` has exactly two producers,
    // a routine one and a climb-attempt one, and every path creates a workout with one or the
    // other, never both. Four is four times the reachable maximum. Raising it means re-running
    // `tests/firebase-rules/workout-expression-budget.test.mjs` and moving the Swift constant in
    // the same change - not editing this number alone.
    function maxWorkoutParticipations() {
      return 4;
    }

    // What this rule is for, and what it deliberately stopped doing.
    //
    // A workout document is private to one climber: nobody else reads it. Firestore aborts at 1000
    // expressions and reports the abort as a bare PERMISSION_DENIED, so an over-budget rule does
    // not fail loudly - it silently stops being able to accept legitimate documents as they grow.
    // Per-field hygiene here was spending that budget on values no reader trusts.
    //
    // The test for dropping a field's type check is NOT "a Cloud Function reads it". It is whether
    // that function REJECTS or COERCES what it reads:
    //
    //   - REJECTS, so the rule need not check it. `steps` and `floors` go through
    //     `nonNegativeIntegerValue` / `nonNegativeInteger`, and `durationSeconds` through
    //     `nonNegativeNumberValue` / `finiteNumber`, in `leaderboardStats`, `climbCompletions` and
    //     `liveReplayLeaderboard`. Each guards on `typeof` and returns null, and null is
    //     fail-closed - the workout simply does not count.
    //   - COERCES, so the rule is the only thing standing between a client and a malformed
    //     server-derived projection. `startedAt` is the one: `timestampMillis` in both
    //     `climbCompletions` and `leaderboardStats` accepts a raw finite `number` as epoch millis,
    //     and `climbCompletions` re-serialises it through `Timestamp.fromMillis` into the landmark
    //     projection. `onWorkoutWritten` retries, so an out-of-range number there is a retry storm
    //     against a projection that never converges. It stays typed here.
    //
    // What stays is authorization and the trust boundary: ownership, canonical identity, the
    // strict top-level key contract, bounded list sizes, the Storage path binding that stops one
    // climber pointing at another's heart-rate sidecar, `startedAt`'s type, and every participation
    // field a Cloud Function reads without re-deriving. What went is owner-private hygiene - scalar
    // ranges, string lengths, media and weight-entry internals, and the timestamp ordering nothing
    // reads.
    //
    // Measure before adding anything here. Do not assume there is room.
    function isValidWorkoutId(workoutId) {
      return workoutId.matches("^[0-9a-fA-F-]{36}$");
    }

    function isValidWorkoutWeightEquipmentType(type) {
      return type in [
        "weighted_vest",
        "dumbbells",
        "barbell",
        "ankle_weights",
        "wrist_weights"
      ];
    }

    function isValidWorkoutWeightEntry(entry, entryKeys) {
      return entry is map &&
        entryKeys.size() == 4 &&
        entryKeys.hasAll([
          "id",
          "equipmentType",
          "weightValue",
          "isEnabled"
        ]) &&
        entry.id is string &&
        isValidWorkoutId(entry.id) &&
        isValidWorkoutWeightEquipmentType(entry.equipmentType) &&
        isNonNegativeNumber(entry.weightValue) &&
        entry.isEnabled is bool;
    }

    function hasUniqueWorkoutWeightEquipmentTypes(entries, count) {
      return
        (count <= 1 || entries[0].equipmentType != entries[1].equipmentType) &&
        (count <= 2 || entries[0].equipmentType != entries[2].equipmentType) &&
        (count <= 3 || entries[0].equipmentType != entries[3].equipmentType) &&
        (count <= 4 || entries[0].equipmentType != entries[4].equipmentType) &&
        (count <= 2 || entries[1].equipmentType != entries[2].equipmentType) &&
        (count <= 3 || entries[1].equipmentType != entries[3].equipmentType) &&
        (count <= 4 || entries[1].equipmentType != entries[4].equipmentType) &&
        (count <= 3 || entries[2].equipmentType != entries[3].equipmentType) &&
        (count <= 4 || entries[2].equipmentType != entries[4].equipmentType) &&
        (count <= 4 || entries[3].equipmentType != entries[4].equipmentType);
    }

    function isValidWorkoutWeightEntryList(entries, count) {
      return entries is list &&
        count <= 5 &&
        (count == 0 || isValidWorkoutWeightEntry(entries[0], entries[0].keys())) &&
        (count <= 1 || isValidWorkoutWeightEntry(entries[1], entries[1].keys())) &&
        (count <= 2 || isValidWorkoutWeightEntry(entries[2], entries[2].keys())) &&
        (count <= 3 || isValidWorkoutWeightEntry(entries[3], entries[3].keys())) &&
        (count <= 4 || isValidWorkoutWeightEntry(entries[4], entries[4].keys())) &&
        hasUniqueWorkoutWeightEquipmentTypes(entries, count);
    }

    // Validated in full for ONE caller: the routine rule's `defaultWeightConfiguration`. Routines
    // are nowhere near the expression ceiling, so they keep the per-entry contract they have always
    // had. The workout rule deliberately does NOT use this - it bounds the list size inline and
    // stops there, because it has no budget left and nothing but the owner reads a workout's
    // weights. Deleting this as dead code would silently break routine backup for any routine
    // carrying default weights.
    function isValidWorkoutWeightConfiguration(config, configKeys) {
      return config is map &&
        configKeys.size() == 1 &&
        configKeys.hasAll(["entries"]) &&
        isValidWorkoutWeightEntryList(config.entries, config.entries.size());
    }

    function isValidWorkoutParticipationContextType(type) {
      return type in [
        "routine_template",
        "routine",
        "climb_attempt",
        "challenge",
        "group_challenge",
        "program_session",
        "achievement"
      ];
    }

    function isValidWorkoutHeartRateSeriesReference(userId, workoutId, reference) {
      return reference is map &&
        reference.keys().hasOnly([
          "storagePath",
          "encoding",
          "sampleCount",
          "seriesStartAt",
          "seriesEndAt",
          "objectSchemaVersion",
          "compressedByteCount",
          "sha256"
        ]) &&
        reference.keys().hasAll([
          "storagePath",
          "encoding",
          "sampleCount",
          "seriesStartAt",
          "seriesEndAt"
        ]) &&
        // The one cross-user boundary in this document: without it a climber could point their
        // workout at somebody else's sidecar object and read it back through the restore path.
        reference.storagePath ==
          "users/" + userId + "/workout_heart_rate/" + workoutId + ".json.gz" &&
        reference.encoding == "json+gzip" &&
        reference.sampleCount is int &&
        reference.sampleCount > 0;
    }

    // Only the fields a Cloud Function reads without re-deriving them.
    //
    // `contextType`, `contextId` and `leaderboardEligible` are the three
    // `liveReplayLeaderboard.hasEligibleParticipation` trusts as written to decide whether a
    // routine-template board publishes a row, so they are a real trust boundary and stay checked
    // here. The climb modes re-derive eligibility from the workout's own evidence and ignore the
    // client's assertion, but the climb-attempt coupling below is the standing guarantee that a
    // Live Climb completion can only come from a live sensor flow - that one is not re-derivable
    // from this document alone, so it stays.
    //
    // `id`, `contextVersion`, `rulesVersion`, `role`, `verificationTier` outside that coupling,
    // and everything inside `metricsSnapshot` are read by nobody but the owner's own device, and
    // `metricsSnapshot` in particular is never read server-side at all - the replay function
    // recomputes from the workout's own `durationSeconds`, `steps` and `sourceMetadata`.
    function isValidWorkoutParticipationItem(userId, workoutId, item, workoutSource) {
      return item is map &&
        item.keys().size() == 12 &&
        item.keys().hasAll([
          "id",
          "workoutId",
          "userId",
          "contextType",
          "contextId",
          "contextVersion",
          "rulesVersion",
          "role",
          "leaderboardEligible",
          "verificationTier",
          "metricsSnapshot",
          "createdAt"
        ]) &&
        item.workoutId == workoutId &&
        item.userId == userId &&
        isValidWorkoutParticipationContextType(item.contextType) &&
        item.contextId is string &&
        item.contextId.size() > 0 &&
        item.contextId.size() <= 160 &&
        item.leaderboardEligible is bool &&
        (
          item.contextType != "climb_attempt" ||
          (
            workoutSource == "headphone_motion" &&
            item.verificationTier == "sensor_verified" &&
            item.role == "primary"
          )
        );
    }

    function isValidWorkoutParticipationList(userId, workoutId, participations, workoutSource) {
      return participations is list &&
        participations.size() <= maxWorkoutParticipations() &&
        (participations.size() == 0 ||
          isValidWorkoutParticipationItem(userId, workoutId, participations[0], workoutSource)) &&
        (participations.size() <= 1 ||
          isValidWorkoutParticipationItem(userId, workoutId, participations[1], workoutSource)) &&
        (participations.size() <= 2 ||
          isValidWorkoutParticipationItem(userId, workoutId, participations[2], workoutSource)) &&
        (participations.size() <= 3 ||
          isValidWorkoutParticipationItem(userId, workoutId, participations[3], workoutSource));
    }

    function isValidWorkoutDocument(userId, workoutId) {
      let data = request.resource.data;
      let keys = data.keys();
      return isCanonicalWorkoutId(workoutId) &&
        keys.hasOnly([
          "userId",
          "schemaVersion",
          "name",
          "startedAt",
          "durationSeconds",
          "steps",
          "floors",
          "stepsPerFloor",
          "notes",
          "source",
          "climbId",
          "integrityLevel",
          "createdAt",
          "updatedAt",
          "avgHeartRateBpm",
          "maxHeartRateBpm",
          "caloriesBurned",
          "effortRating",
          "averageMETs",
          "deviceModel",
          "sourceMetadata",
          "healthKitUUID",
          "hevyWorkoutId",
          "media",
          "highlightedMediaId",
          "weightConfiguration",
          "heartRateSeries",
          "participations"
        ]) &&
        keys.hasAll([
          "userId",
          "schemaVersion",
          "name",
          "startedAt",
          "durationSeconds",
          "steps",
          "floors",
          "stepsPerFloor",
          "notes",
          "source",
          "integrityLevel",
          "createdAt",
          "updatedAt"
        ]) &&
        data.userId == userId &&
        isSupportedSchemaVersion(data.schemaVersion) &&
        // The one scalar type check the budget still buys, because `climbCompletions` coerces this
        // value rather than rejecting it - see the philosophy block above.
        data.startedAt is timestamp &&
        isValidWorkoutSource(data.source) &&
        isValidIntegrityLevel(data.integrityLevel) &&
        // A climb query key only means anything on an in-app sensor workout, and
        // `climbCompletions` reads it to decide which landmark a session counted toward.
        (!keys.hasAny(["climbId"]) ||
          (data.source == "headphone_motion" &&
            data.climbId is string &&
            data.climbId.size() > 0 &&
            data.climbId.size() <= 160)) &&
        // Bounded because two Cloud Functions parse it, not to police its contents.
        (!keys.hasAny(["sourceMetadata"]) ||
          (data.sourceMetadata is string && data.sourceMetadata.size() <= 4000)) &&
        (!keys.hasAny(["media"]) ||
          (data.media is list && data.media.size() <= 3)) &&
        (!keys.hasAny(["weightConfiguration"]) ||
          (data.weightConfiguration is map &&
            data.weightConfiguration.keys().hasOnly(["entries"]) &&
            data.weightConfiguration.entries is list &&
            data.weightConfiguration.entries.size() <= 5)) &&
        (!keys.hasAny(["heartRateSeries"]) ||
          isValidWorkoutHeartRateSeriesReference(userId, workoutId, data.heartRateSeries)) &&
        (!keys.hasAny(["participations"]) ||
          isValidWorkoutParticipationList(userId, workoutId, data.participations, data.source));
    }

    // A user-authored routine or folder lives at one document id spelling: the
    // uppercase UUID Swift's `UUID.uuidString` already produces. Accepting any
    // other casing would fork one routine into two documents, which is exactly
    // the restore-time collision workouts had to be repaired for.
    function isCanonicalRecordId(recordId) {
      return recordId.matches("^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$");
    }

    // Only routines the climber authored are backed up. Catalog templates
    // (`builtin`, `remoteTemplate`) are server-owned content re-derived on every
    // device from routine_templates, so a client that tried to upload one would
    // be writing our content back to us under their own uid.
    function isValidUserRoutineSource(source) {
      return source in ["userCreated", "copiedFromBuiltin"];
    }

    // How many intervals one routine may back up.
    //
    // 40 covers twenty work/rest rounds, which is past anything the shipped
    // catalog does (it averages five intervals, longest nine) and past any
    // interval session a stair stepper realistically holds.
    function maxRoutineIntervals() {
      return 40;
    }

    // Intervals are bounded and typed as a list, and deliberately NOT validated
    // element by element. That is a measurement, not an oversight.
    //
    // A rule evaluation aborts at 1000 expressions, and rules functions inline
    // their arguments, so every `item.<field>` re-evaluates the whole
    // `request.resource.data.intervals[i]` chain. Measured against the emulator
    // with this document: a full per-element validator (hasOnly/hasAll plus the
    // ten interval fields) fits exactly TWO intervals before the write starts
    // failing with a bare PERMISSION_DENIED; a validator narrowed to four typed
    // fields fits eleven; `item is map` alone fits twenty-four. Every one of
    // those ceilings is below a normal interval routine, and a routine that
    // silently stops backing up at interval eleven is a worse outcome than an
    // unvalidated interval body. This is the same wall the workout rule hit in
    // issue #295.
    //
    // What makes the trade acceptable here and not there: a workout's
    // `participations` are read and trusted by Cloud Functions that publish
    // leaderboard rows, so their contents are a real trust boundary. A user
    // routine is private to one climber - no other client reads it, and no
    // server code derives anything from it - so the boundary that matters is
    // ownership plus the strict `hasOnly`/`hasAll` on the document itself, both
    // of which are enforced above. Interval bodies are validated where they can
    // be validated for free: `RoutineRemoteSyncMapper` writes them and
    // `FirestoreUserRoutineDocument` decodes them, dropping any interval it
    // cannot read rather than restoring a corrupt one.
    //
    // Before adding any check here, re-measure. Do not assume there is room.
    function isValidRoutineIntervalList(intervals) {
      return intervals is list &&
        intervals.size() <= maxRoutineIntervals();
    }

    function isValidUserRoutineDocument(userId, routineId) {
      return isCanonicalRecordId(routineId) &&
        request.resource.data.keys().hasOnly([
          "userId",
          "schemaVersion",
          "name",
          "description",
          "source",
          "intervals",
          "folderId",
          "isArchived",
          "order",
          "templateId",
          "templateVersion",
          "difficulty",
          "estimatedCalories",
          "defaultWeightConfiguration",
          "completionCount",
          "lastCompletedAt",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "schemaVersion",
          "name",
          "description",
          "source",
          "intervals",
          "isArchived",
          "order",
          "completionCount",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.userId == userId &&
        isSupportedSchemaVersion(request.resource.data.schemaVersion) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000 &&
        isValidUserRoutineSource(request.resource.data.source) &&
        isValidRoutineIntervalList(request.resource.data.intervals) &&
        (!request.resource.data.keys().hasAny(["folderId"]) ||
          (request.resource.data.folderId is string &&
            isCanonicalRecordId(request.resource.data.folderId))) &&
        request.resource.data.isArchived is bool &&
        request.resource.data.order is int &&
        request.resource.data.order >= 0 &&
        (!request.resource.data.keys().hasAny(["templateId"]) ||
          (request.resource.data.templateId is string &&
            request.resource.data.templateId.size() > 0 &&
            request.resource.data.templateId.size() <= 160)) &&
        (!request.resource.data.keys().hasAny(["templateVersion"]) ||
          (request.resource.data.templateVersion is int &&
            request.resource.data.templateVersion >= 0)) &&
        (!request.resource.data.keys().hasAny(["difficulty"]) ||
          (request.resource.data.difficulty is int &&
            request.resource.data.difficulty >= 0 &&
            request.resource.data.difficulty <= 25)) &&
        (!request.resource.data.keys().hasAny(["estimatedCalories"]) ||
          (request.resource.data.estimatedCalories is int &&
            request.resource.data.estimatedCalories >= 0)) &&
        (!request.resource.data.keys().hasAny(["defaultWeightConfiguration"]) ||
          isValidWorkoutWeightConfiguration(
            request.resource.data.defaultWeightConfiguration,
            request.resource.data.defaultWeightConfiguration.keys()
          )) &&
        request.resource.data.completionCount is int &&
        request.resource.data.completionCount >= 0 &&
        (!request.resource.data.keys().hasAny(["lastCompletedAt"]) ||
          request.resource.data.lastCompletedAt is timestamp) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
    }

    function isValidRoutineFolderDocument(userId, folderId) {
      return isCanonicalRecordId(folderId) &&
        request.resource.data.keys().hasOnly([
          "userId",
          "schemaVersion",
          "name",
          "colorHex",
          "order",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "schemaVersion",
          "name",
          "order",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.userId == userId &&
        isSupportedSchemaVersion(request.resource.data.schemaVersion) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        (!request.resource.data.keys().hasAny(["colorHex"]) ||
          (request.resource.data.colorHex is string &&
            request.resource.data.colorHex.matches("^#[0-9a-fA-F]{6}$"))) &&
        request.resource.data.order is int &&
        request.resource.data.order >= 0 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
    }

    function userRateLimitDocPath() {
      return /databases/$(database)/documents/userRateLimits/$(request.auth.uid);
    }

    function feedbackCooldownPassed() {
      return !exists(userRateLimitDocPath()) ||
        !get(userRateLimitDocPath()).data.keys().hasAny(["lastFeedback"]) ||
        (
          get(userRateLimitDocPath()).data.lastFeedback is timestamp &&
          request.time >
            get(userRateLimitDocPath()).data.lastFeedback +
              duration.value(60, "s")
        );
    }

    function isValidFeedbackDocument() {
      return request.resource.data.keys().hasOnly([
          "type",
          "message",
          "userId",
          "userEmail",
          "timestamp",
          "appVersion",
          "buildNumber",
          "deviceModel",
          "osVersion",
          "status"
        ]) &&
        request.resource.data.keys().hasAll([
          "type",
          "message",
          "userId",
          "userEmail",
          "timestamp",
          "appVersion",
          "buildNumber",
          "deviceModel",
          "osVersion",
          "status"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type is string &&
        isValidFeedbackType(request.resource.data.type) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 10 &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.userEmail is string &&
        request.resource.data.userEmail.size() <= 320 &&
        request.resource.data.timestamp is timestamp &&
        request.resource.data.appVersion is string &&
        request.resource.data.appVersion.size() <= 32 &&
        request.resource.data.buildNumber is string &&
        request.resource.data.buildNumber.size() <= 32 &&
        request.resource.data.deviceModel is string &&
        request.resource.data.deviceModel.size() <= 120 &&
        request.resource.data.osVersion is string &&
        request.resource.data.osVersion.size() <= 40 &&
        request.resource.data.status == "new";
    }

    function moderationReportCooldownPassed() {
      return !exists(userRateLimitDocPath()) ||
        !get(userRateLimitDocPath()).data.keys()
          .hasAny(["lastModerationReport"]) ||
        (
          get(userRateLimitDocPath()).data.lastModerationReport is timestamp &&
          request.time >
            get(userRateLimitDocPath()).data.lastModerationReport +
              duration.value(60, "s")
        );
    }

    function moderationRateLimitAdvanced(reportId) {
      return getAfter(userRateLimitDocPath())
          .data.lastModerationReport == request.time &&
        getAfter(userRateLimitDocPath())
          .data.lastModerationReportId == reportId;
    }

    function hasValidRateLimitSchema() {
      return request.resource.data.keys().hasOnly([
          "lastFeedback",
          "lastModerationReport",
          "lastModerationReportId"
        ]) &&
        request.resource.data.keys().hasAny([
          "lastFeedback",
          "lastModerationReport"
        ]) &&
        (!request.resource.data.keys().hasAny(["lastFeedback"]) ||
          request.resource.data.lastFeedback is timestamp) &&
        (!request.resource.data.keys().hasAny(["lastModerationReport"]) ||
          request.resource.data.lastModerationReport is timestamp) &&
        (
          request.resource.data.keys().hasAny(["lastModerationReport"]) ==
            request.resource.data.keys().hasAny(["lastModerationReportId"])
        ) &&
        (!request.resource.data.keys().hasAny(["lastModerationReportId"]) ||
          (request.resource.data.lastModerationReportId is string &&
            request.resource.data.lastModerationReportId.size() > 0 &&
            request.resource.data.lastModerationReportId.size() <= 128));
    }

    function isValidUserRateLimitCreate() {
      return hasValidRateLimitSchema() &&
        (!request.resource.data.keys().hasAny(["lastFeedback"]) ||
          request.resource.data.lastFeedback == request.time) &&
        (!request.resource.data.keys().hasAny(["lastModerationReport"]) ||
          request.resource.data.lastModerationReport == request.time);
    }

    function isValidUserRateLimitUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return hasValidRateLimitSchema() &&
        changed.hasAny([
          "lastFeedback",
          "lastModerationReport",
          "lastModerationReportId"
        ]) &&
        changed.hasOnly([
          "lastFeedback",
          "lastModerationReport",
          "lastModerationReportId"
        ]) &&
        (!changed.hasAny(["lastFeedback"]) ||
          request.resource.data.lastFeedback == request.time) &&
        (
          !changed.hasAny([
            "lastModerationReport",
            "lastModerationReportId"
          ]) ||
          (
            changed.hasAll([
              "lastModerationReport",
              "lastModerationReportId"
            ]) &&
            request.resource.data.lastModerationReport == request.time
          )
        );
    }

    function isValidBlockedClimberDocument(blockedUserId) {
      return request.resource.data.keys().hasOnly([
          "blockedUid",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "blockedUid",
          "createdAt"
        ]) &&
        request.resource.data.blockedUid is string &&
        request.resource.data.blockedUid == blockedUserId &&
        request.resource.data.blockedUid != request.auth.uid &&
        request.resource.data.blockedUid.size() > 0 &&
        request.resource.data.blockedUid.size() <= 128 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.createdAt == request.time;
    }

    function isValidModerationReportDocument() {
      return request.resource.data.keys().hasOnly([
          "reportedUserId",
          "reporterUserId",
          "reason",
          "source",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "reportedUserId",
          "reporterUserId",
          "reason",
          "source",
          "createdAt"
        ]) &&
        request.resource.data.reporterUserId == request.auth.uid &&
        request.resource.data.reportedUserId is string &&
        request.resource.data.reportedUserId != request.auth.uid &&
        request.resource.data.reportedUserId.size() > 0 &&
        request.resource.data.reportedUserId.size() <= 128 &&
        request.resource.data.reason is string &&
        request.resource.data.reason in [
          "harassment",
          "hate_speech",
          "inappropriate_name",
          "inappropriate_photo",
          "impersonation",
          "spam",
          "other"
        ] &&
        request.resource.data.source is string &&
        request.resource.data.source in [
          "global_leaderboard",
          "live_replay",
          "completion_leaderboard",
          "community_avatars",
          "first_ascent",
          "profile"
        ] &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserDocument();
      allow update: if isOwner(userId) &&
        isValidUserDocument() &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      // External integrations are written server-side; clients can only read their own.
      match /integrations/{integrationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Lifecycle automation state is written by Cloud Functions so client
      // event payloads stay validated and server-owned.
      match /lifecycle/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /lifecycle_events/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /communication_preferences/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /notification_devices/{deviceId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Paid access is a server-owned RevenueCat projection. Clients cannot
      // read or forge the timestamp that the rules evaluate.
      match /entitlements/{entitlementId} {
        allow read, write: if false;
      }

      match /entitlement_status/{entitlementId} {
        allow read, write: if false;
      }

      // Server-owned cooldown for the self-service reconciliation callable.
      // A client that could write it could turn recovery into an unbounded
      // RevenueCat subscriber-API amplifier.
      match /entitlement_reconciliations/{docId} {
        allow read, write: if false;
      }

      // Read is owner-gated, not paid-gated, on every owner-private collection
      // the account-deletion sweep enumerates (workouts, routines,
      // routine_folders, profile_workouts). Deleting an account means listing
      // each collection and deleting what comes back, and Firestore evaluates a
      // list rule against the query rather than the stored documents - so a
      // paid gate here refuses an unentitled owner's sweep even when the
      // collection is empty, and guideline 5.1.1(v) deletion becomes impossible
      // the moment a subscription lapses. Read therefore matches the delete
      // gate exactly. Splitting `get` from `list` would buy nothing: a list
      // returns full document bodies. Create and update stay paid.
      match /workouts/{workoutId} {
        allow read: if isOwner(userId);
        allow create: if isPaidOwner(userId) &&
          isValidWorkoutDocument(userId, workoutId);
        // The stored schema version may only move forward. Equality would make
        // every stored document un-updatable the day the number is bumped, since
        // an updated client always emits the new number. Writes are whole-document
        // `setData`, so allowing it to move backward would instead let an older
        // build drop the fields a newer schema added.
        allow update: if isPaidOwner(userId) &&
          isValidWorkoutDocument(userId, workoutId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.schemaVersion >= resource.data.schemaVersion &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // Routines the climber built themselves, and the folders they organise
      // them into. Private backup only: nobody but the owner reads or writes
      // them, and no server code derives anything from them. Deliberately kept
      // away from the top-level `routine_templates`, which is server-owned
      // published content and must stay read-only to every client.
      match /routines/{routineId} {
        allow read: if isOwner(userId);
        allow create: if isPaidOwner(userId) &&
          isValidUserRoutineDocument(userId, routineId);
        // Same forward-only schema version rule as workouts, and for the same
        // reason: writes are whole-document `setData`, so letting the stored
        // version move backward would let an older build drop the fields a
        // newer schema added.
        allow update: if isPaidOwner(userId) &&
          isValidUserRoutineDocument(userId, routineId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.schemaVersion >= resource.data.schemaVersion &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /routine_folders/{folderId} {
        allow read: if isOwner(userId);
        allow create: if isPaidOwner(userId) &&
          isValidRoutineFolderDocument(userId, folderId);
        allow update: if isPaidOwner(userId) &&
          isValidRoutineFolderDocument(userId, folderId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.schemaVersion >= resource.data.schemaVersion &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /liveClimbPublishStatuses/{workoutId} {
        allow read: if isPaidOwner(userId);
        allow write: if false;
      }

      // Server-derived completed-climb projection. One Cloud Function
      // (onWorkoutWritten) derives it from the canonical private workouts and
      // writes it via the Admin SDK, which bypasses these rules; clients only
      // ever read their own. Same "client reads its own, only the server
      // writer writes" shape as achievements / liveClimbPublishStatuses.
      match /landmarkResults/{landmarkId} {
        allow read: if isPaidOwner(userId);
        allow write: if false;
      }

      match /public_profile/{docId} {
        allow read: if isSignedIn() && docId == "current";
        allow create: if isOwner(userId) &&
          docId == "current" &&
          isValidPublicProfileDocument(userId) &&
          isValidIdentityPolicyCreate();
        allow update: if isOwner(userId) &&
          docId == "current" &&
          isValidPublicProfileDocument(userId) &&
          isValidIdentityPolicyUpdate();
        allow delete: if isOwner(userId) && docId == "current";
      }

      match /profile_stats/{docId} {
        allow read: if hasPaidAppAccess() && docId == "current";
        allow create, update: if isPaidOwner(userId) &&
          docId == "current" &&
          isValidProfileStatsDocument();
        allow delete: if isOwner(userId) && docId == "current";
      }

      // Unlike the collections above this one is cross-account readable, so the
      // paid gate stays for everyone else and the owner is added to it rather
      // than replacing it.
      match /profile_workouts/{workoutId} {
        allow read: if isOwner(userId) || hasPaidAppAccess();
        allow create, update: if isPaidOwner(userId) &&
          isCanonicalWorkoutId(workoutId) &&
          isValidProfileWorkoutSummary();
        allow delete: if isOwner(userId);
      }

      match /achievements/{achievementId} {
        allow read: if hasPaidAppAccess();
        allow write: if false;
      }

      // A block is private to its owner. It never changes leaderboard data or
      // exposes one user's safety choices to another user.
      match /blocked/{blockedUserId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidBlockedClimberDocument(blockedUserId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // Global standings are server-derived. functions/src/leaderboardStats.ts
    // recomputes them from the canonical private workouts and writes them with
    // the Admin SDK, which bypasses these rules. Nothing a client sends can
    // reach this collection: the totals here are what the nightly finalizer
    // freezes into permanent achievements, and validating a client-authored
    // aggregate's shape is not validating its evidence (issue #307). Reads stay
    // open to every paid climber - the board is the conversation.
    match /leaderboard_stats/{docId} {
      allow read: if hasPaidAppAccess();
      allow write: if false;
    }

    match /leaderboard_periods/{docId} {
      allow read, write: if false;
    }

    // Remote routine templates are content-managed and server-owned.
    // Clients can only read published templates.
    match /routine_templates/{templateId} {
      allow read: if hasPaidAppAccess() &&
        resource.data.status == "published";
      allow write: if false;
    }

    // Time-aligned replay leaderboard indexes are server-published from saved attempts.
    // Clients only read tiny window buckets during live sessions.
    match /live_replay_leaderboards/{contextKey} {
      allow read: if hasPaidAppAccess();
      allow write: if false;

      match /splitBuckets/{bucketId} {
        allow read: if hasPaidAppAccess();
        allow write: if false;

        match /entries/{entryId} {
          allow read: if hasPaidAppAccess();
          allow write: if false;
        }
      }

      match /finishers/{userId} {
        allow read: if hasPaidAppAccess();
        allow write: if false;
      }

      match /completionSnapshots/{workoutId} {
        allow read: if hasPaidAppAccess();
        allow write: if false;
      }
    }

    // Global Live Climb community stats are server-owned aggregates.
    match /live_climb_community_stats/{docId} {
      allow read: if hasPaidAppAccess() && docId == "global";
      allow write: if false;

      // Per-user dedupe markers are server-only and are not client-readable.
      match /completedUsers/{userId} {
        allow read, write: if false;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() &&
        isValidFeedbackDocument() &&
        feedbackCooldownPassed();
      allow read, update, delete: if false;
    }

    // Reports are a write-only moderation queue for clients. Review and
    // resolution happen through trusted Admin SDK or console access.
    match /moderation_reports/{reportId} {
      allow create: if isSignedIn() &&
        isValidModerationReportDocument() &&
        exists(
          /databases/$(database)/documents/users/$(request.resource.data.reportedUserId)
        ) &&
        moderationReportCooldownPassed() &&
        moderationRateLimitAdvanced(reportId);
      allow read, update, delete: if false;
    }

    match /userRateLimits/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserRateLimitCreate();
      allow update: if isOwner(userId) && isValidUserRateLimitUpdate();
      allow delete: if false;
    }

    // Remote share-card template manifest is read-only for paid users.
    match /config/{docId} {
      allow read: if hasPaidAppAccess() && docId == "shareCardTemplates";
      allow write: if false;
    }

    // Server-only collections managed by Cloud Functions / Admin SDK.
    match /email_jobs/{docId} {
      allow read, write: if false;
    }

    match /notification_devices/{deviceId} {
      allow read, write: if false;
    }

    match /notification_campaigns/{campaignId} {
      allow read, write: if false;
    }

    match /_public_identity_propagation_jobs/{userId} {
      allow read, write: if false;

      match /kinds/{kind} {
        allow read, write: if false;
      }
    }

    match /_revenuecat_webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /_revenuecat_analytics_outbox/{eventId} {
      allow read, write: if false;
    }

  }
}
