---
// Reusable App Store badge. With no `href` it renders a non-linking
// "Coming soon" badge; pass the App Store URL at launch to make it a live
// "Download on the App Store" link.
interface Props {
  href?: string;
}
const { href } = Astro.props;
const live = Boolean(href);
const Tag = live ? 'a' : 'div';
---
<Tag class="store-badge" href={href} aria-label={live ? 'Download on the App Store' : 'Coming soon on the App Store'}>
  <svg class="store-badge__logo" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
    <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
  </svg>
  <span class="store-badge__text">
    <small>{live ? 'Download on the' : 'Coming soon on the'}</small>
    <strong>App Store</strong>
  </span>
</Tag>

<style>
  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding: 11px 22px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  a.store-badge:hover {
    border-color: rgba(134, 211, 10, 0.6);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-1px);
  }

  .store-badge__logo {
    width: 23px;
    height: 27px;
    flex: none;
  }

  .store-badge__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-align: left;
  }

  .store-badge__text small {
    font-size: 11px;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.66);
  }

  .store-badge__text strong {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
</style>
