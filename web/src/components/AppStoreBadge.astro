---
// Apple's official "Download on the App Store" badge, rendered as supplied.
// The Marketing Guidelines forbid recreating or restyling the artwork, so the
// SVG is served unaltered and the link draws no chrome of its own. `href` is
// required: Ascend is live, so there is no non-linking state to render.
interface Props {
  href: string;
}
const { href } = Astro.props;
---
<a class="store-badge" href={href}>
  <img
    src="/images/apple-app-store-badge.svg"
    alt="Download on the App Store"
    width="120"
    height="40"
  />
</a>

<style>
  .store-badge {
    display: inline-block;
    line-height: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .store-badge:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .store-badge img {
    height: 48px;
    width: auto;
  }
</style>
