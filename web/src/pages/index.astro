---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Ascend - Stair-Stepper Training App" description="Ascend is the iOS app made for the stair stepper: live climbs to race, best efforts to beat, routines to run, trends to track, and every reason to keep climbing.">

  <style>
    .hero {
      position: relative;
      min-height: 84vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 148px 40px 104px;
      isolation: isolate;
      border-bottom: 1px solid var(--border);
      background: #090d12;
    }

    .hero::before {
      content: none;
    }

    .hero::after {
      content: none;
    }

    .hero-artifacts {
      position: absolute;
      inset: 86px 32px 38px;
      z-index: 1;
      width: min(calc(100% - 64px), 1500px);
      margin: 0 auto;
      pointer-events: none;
    }

    .hero-artifact {
      position: absolute;
      left: var(--left);
      top: var(--top);
      width: max-content;
      height: max-content;
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.78);
      animation: artifactEnter 0.72s cubic-bezier(0.19, 1, 0.22, 1) forwards;
      animation-delay: var(--delay);
      will-change: opacity, transform;
    }

    .artifact-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #f4f6f8;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(13, 18, 24, 0.82);
      box-shadow:
        0 18px 54px rgba(0, 0, 0, 0.34),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      animation: artifactFloat var(--duration, 7s) ease-in-out infinite alternate;
      animation-delay: calc(var(--delay) + 0.7s);
      will-change: transform;
    }

    .hero-climb-card .artifact-inner {
      position: relative;
      width: var(--width, 166px);
      height: var(--height, 202px);
      display: block;
      padding: 0;
      border-radius: 18px;
      overflow: hidden;
      border-color: color-mix(in srgb, var(--tone, var(--accent)) 42%, rgba(255, 255, 255, 0.12));
      background: #0b0f14;
      box-shadow:
        0 22px 64px rgba(0, 0, 0, 0.44),
        0 0 0 1px color-mix(in srgb, var(--tone, var(--accent)) 18%, transparent),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .hero-climb-card img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.02);
    }

    .hero-climb-card-copy {
      position: absolute;
      inset: auto 0 0;
      display: grid;
      gap: 3px;
      padding: 46px 13px 13px;
      background: linear-gradient(180deg, rgba(5, 7, 10, 0) 0%, rgba(5, 7, 10, 0.78) 46%, rgba(5, 7, 10, 0.94) 100%);
    }

    .hero-climb-card-copy strong,
    .hero-climb-card-copy span {
      position: relative;
      z-index: 1;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.62);
    }

    .hero-climb-card-copy strong {
      color: #f6f8fb;
      font-size: 15px;
      font-weight: 850;
      line-height: 1.05;
    }

    .hero-climb-card-copy span {
      color: #c7d0dc;
      font-size: 11px;
      font-weight: 760;
      letter-spacing: 0.04em;
      line-height: 1;
      text-transform: uppercase;
    }

    .stat-chip .artifact-inner,
    .rank-chip .artifact-inner {
      min-width: var(--width, 132px);
      min-height: 54px;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 999px;
    }

    .stat-icon,
    .rank-icon {
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      border-radius: 999px;
      background: rgba(180, 204, 0, 0.16);
      color: var(--accent);
      font-size: 14px;
      font-weight: 900;
    }

    .stat-copy,
    .rank-copy {
      display: grid;
      gap: 1px;
      text-align: left;
    }

    .stat-copy strong,
    .rank-copy strong {
      color: #f6f8fb;
      font-size: 15px;
      font-weight: 850;
      line-height: 1;
      white-space: nowrap;
    }

    .stat-copy span,
    .rank-copy span {
      color: #a5afbd;
      font-size: 11px;
      font-weight: 750;
      letter-spacing: 0.04em;
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .routine-chip .artifact-inner {
      width: var(--width, 158px);
      min-height: 90px;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      padding: 14px;
      border-radius: 12px;
      border-left: 3px solid var(--tone, var(--accent));
    }

    .routine-chip strong {
      color: #f6f8fb;
      font-size: 15px;
      font-weight: 850;
      line-height: 1;
    }

    .routine-chip span {
      color: #a5afbd;
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
    }

    .routine-bars {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      align-items: end;
      gap: 4px;
      height: 28px;
    }

    .routine-bars i {
      display: block;
      height: var(--h);
      border-radius: 3px 3px 1px 1px;
      background: var(--tone, var(--accent));
    }

    .best-effort-chip .artifact-inner {
      width: var(--size, 108px);
      height: var(--size, 108px);
      flex-direction: column;
      gap: 4px;
      padding: 14px;
      border-radius: 16px;
      border-color: rgba(255, 207, 70, 0.28);
    }

    .best-effort-chip .laurel {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      margin-bottom: 3px;
      border-radius: 999px;
      background: rgba(255, 207, 70, 0.14);
      color: #ffd45b;
      font-size: 18px;
      font-weight: 900;
    }

    .best-effort-chip strong {
      color: #f6f8fb;
      font-size: 14px;
      font-weight: 850;
      line-height: 1.08;
      text-align: center;
    }

    .best-effort-chip span {
      color: #a5afbd;
      font-size: 11px;
      font-weight: 700;
    }

    .hero-inner {
      width: min(100%, 1040px);
      margin: 0 auto;
      display: flex;
      justify-content: center;
      position: relative;
      z-index: 2;
    }

    .hero-content {
      max-width: 1040px;
      text-align: center;
    }

    .hero h1 {
      max-width: 1040px;
      margin-bottom: 24px;
      font-size: clamp(44px, 5.6vw, 74px);
      font-weight: 850;
      line-height: 1.02;
      letter-spacing: 0;
    }

    .hero h1 span {
      display: block;
    }

    .hero h1 .accent {
      color: var(--accent);
    }

    .hero .subtitle {
      max-width: 820px;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 32px;
      color: #b9c2cf;
      font-size: 20px;
      line-height: 1.62;
    }

    .hero-actions {
      max-width: 620px;
      margin: 0 auto;
    }

    .waitlist-form {
      display: flex;
      gap: 12px;
      margin-bottom: 0;
    }

    .waitlist-form input {
      flex: 1;
      min-width: 0;
      padding: 14px 18px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.08);
      color: var(--text);
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s, background 0.2s;
    }

    .waitlist-form input.input-error {
      border-color: rgba(255, 107, 107, 0.9);
      box-shadow: 0 0 0 1px rgba(255, 107, 107, 0.25);
    }

    .waitlist-form input::placeholder {
      color: #929dac;
    }

    .waitlist-form input:focus {
      border-color: rgba(180, 204, 0, 0.72);
      background: rgba(255, 255, 255, 0.11);
    }

    .waitlist-form button,
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      padding: 14px 24px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.9);
      background: #f2f4f7;
      color: #080c10;
      font-size: 16px;
      font-weight: 800;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, transform 0.1s;
      white-space: nowrap;
    }

    .waitlist-form button:hover,
    .btn:hover {
      border-color: var(--accent);
      background: #ffffff;
    }

    .waitlist-form button:active,
    .btn:active {
      transform: scale(0.98);
    }

    .waitlist-form button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .waitlist-note {
      color: #95a0ad;
      font-size: 14px;
      line-height: 1.55;
    }

    .waitlist-success {
      display: none;
      position: relative;
      padding: 16px 20px 16px 56px;
      border-radius: 8px;
      border: 1px solid rgba(180, 204, 0, 0.36);
      background: linear-gradient(
        120deg,
        rgba(180, 204, 0, 0.2) 0%,
        rgba(180, 204, 0, 0.08) 55%,
        rgba(180, 204, 0, 0.12) 100%
      );
      color: #d6ed58;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.45;
      overflow: hidden;
      isolation: isolate;
    }

    .waitlist-success.show {
      display: block;
      animation: waitlistReveal 0.55s cubic-bezier(0.19, 1, 0.22, 1) both;
    }

    .waitlist-success::before {
      content: "✓";
      position: absolute;
      left: 18px;
      top: 50%;
      width: 24px;
      height: 24px;
      display: grid;
      place-items: center;
      transform: translateY(-50%);
      border-radius: 999px;
      background: linear-gradient(135deg, #d8f451 0%, #b4cc00 100%);
      color: #101722;
      font-size: 13px;
      font-weight: 800;
    }

    .waitlist-success::after {
      content: "";
      position: absolute;
      inset: -40%;
      z-index: -1;
      background: linear-gradient(
        115deg,
        transparent 35%,
        rgba(255, 255, 255, 0.32) 50%,
        transparent 65%
      );
      transform: translateX(-75%) rotate(8deg);
      opacity: 0;
    }

    .waitlist-success.is-subscribed::before {
      animation: waitlistPulse 0.9s ease-out 0.15s 1 both;
    }

    .waitlist-success.is-subscribed::after {
      opacity: 0.7;
      animation: waitlistSweep 0.9s ease-out 0.05s 1 both;
    }

    .waitlist-success.is-existing {
      border-color: rgba(125, 160, 255, 0.4);
      background: linear-gradient(
        120deg,
        rgba(95, 133, 230, 0.24) 0%,
        rgba(65, 96, 186, 0.11) 60%,
        rgba(104, 138, 225, 0.2) 100%
      );
      color: #c9dbff;
    }

    .waitlist-success.is-existing::before {
      content: "↺";
      background: linear-gradient(135deg, #a9c5ff 0%, #7fa8ff 100%);
      color: #0e1628;
    }

    .waitlist-success.is-existing::after {
      opacity: 0.45;
      animation: waitlistSweep 1.1s ease-out 0.05s 1 both;
    }

    .waitlist-burst {
      position: absolute;
      left: 30px;
      top: 50%;
      width: 0;
      height: 0;
      pointer-events: none;
      z-index: 2;
    }

    .waitlist-burst span {
      position: absolute;
      left: 0;
      top: 0;
      width: 8px;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, #efff94 0%, #b4cc00 100%);
      opacity: 0;
      transform: translate(-50%, -50%) rotate(var(--r));
      animation: waitlistParticle 0.72s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d);
    }

    .waitlist-error {
      display: none;
      margin-top: 8px;
      padding: 12px 16px;
      border-radius: 8px;
      border: 1px solid rgba(255, 80, 80, 0.3);
      background: rgba(255, 80, 80, 0.1);
      color: #ff7b7b;
      font-size: 14px;
    }

    .phone-frame {
      position: relative;
      width: 276px;
      height: 600px;
      border-radius: 42px;
      background: #050608;
      padding: 12px;
      box-shadow:
        0 28px 70px rgba(0, 0, 0, 0.56),
        0 0 0 1px rgba(255, 255, 255, 0.08),
        inset 0 0 0 1px rgba(255, 255, 255, 0.06);
      overflow: hidden;
    }

    .phone-frame::before {
      content: "";
      position: absolute;
      top: 17px;
      left: 50%;
      z-index: 2;
      width: 96px;
      height: 27px;
      transform: translateX(-50%);
      border-radius: 999px;
      background: #030405;
    }

    .phone-frame.app-screenshot {
      padding: 0;
      border-radius: 34px;
    }

    .phone-frame.app-screenshot::before {
      display: none;
    }

    .phone-frame.app-screenshot .screen {
      border-radius: 34px;
    }

    .screen {
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 31px;
      background: #121722;
    }

    .screen img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-proof {
      width: min(100%, var(--max-width));
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.08);
    }

    .proof-item {
      min-height: 110px;
      padding: 22px;
      background: rgba(12, 17, 23, 0.8);
    }

    .proof-item strong {
      display: block;
      margin-bottom: 6px;
      color: var(--text);
      font-size: clamp(24px, 3vw, 34px);
      line-height: 1;
    }

    .proof-item span {
      display: block;
      color: #97a2af;
      font-size: 13px;
      line-height: 1.45;
    }

    .section {
      padding: 104px 40px;
    }

    .proof-section {
      padding-top: 28px;
      padding-bottom: 76px;
    }

    .screens-section {
      padding-top: 72px;
      padding-bottom: 84px;
    }

    .section-inner {
      width: min(100%, var(--max-width));
      margin: 0 auto;
    }

    .section-heading {
      max-width: 720px;
      margin-bottom: 54px;
    }

    .section-heading.centered {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    .section-kicker {
      margin-bottom: 12px;
      color: var(--accent);
      font-size: 12px;
      font-weight: 850;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .section h2 {
      font-size: clamp(32px, 4.6vw, 56px);
      font-weight: 850;
      line-height: 1;
      letter-spacing: 0;
    }

    .section-heading p {
      margin-top: 18px;
      color: #a8b2bf;
      font-size: 18px;
      line-height: 1.7;
    }

    .feature-rows {
      display: grid;
      gap: 70px;
    }

    .feature-row {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1fr);
      gap: 70px;
      align-items: center;
      padding: 70px 0;
      border-top: 1px solid var(--border);
    }

    .feature-row:last-child {
      border-bottom: 1px solid var(--border);
    }

    .feature-row.reversed {
      grid-template-columns: minmax(360px, 1fr) minmax(0, 0.9fr);
    }

    .feature-row.reversed .feature-copy {
      order: 2;
    }

    .feature-row.reversed .feature-visual {
      order: 1;
    }

    .feature-copy h3 {
      margin-bottom: 16px;
      font-size: clamp(28px, 3.4vw, 42px);
      font-weight: 820;
      line-height: 1.08;
      letter-spacing: 0;
    }

    .feature-copy p {
      color: #a8b2bf;
      font-size: 17px;
      line-height: 1.72;
    }

    .feature-points {
      display: grid;
      gap: 12px;
      margin-top: 26px;
      list-style: none;
    }

    .feature-points li {
      position: relative;
      padding-left: 24px;
      color: #d9dee6;
      font-size: 15px;
      line-height: 1.5;
    }

    .feature-points li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.62em;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }

    .feature-visual {
      display: flex;
      justify-content: center;
    }

    .feature-phone-stack {
      position: relative;
      width: min(100%, 560px);
      min-height: 620px;
    }

    .feature-phone-stack .phone-frame {
      position: absolute;
      height: auto;
      aspect-ratio: 736 / 1600;
    }

    .feature-phone-stack .phone-stack-back {
      left: 0;
      top: 36px;
      width: 270px;
      transform: rotate(-5deg);
      opacity: 0.88;
    }

    .feature-phone-stack .phone-stack-front {
      right: 18px;
      top: 0;
      width: 292px;
      z-index: 2;
    }

    .routine-preview-phone {
      width: 300px;
      height: auto;
      aspect-ratio: 736 / 1600;
    }

    .wide-phone {
      width: 300px;
      height: 652px;
    }

    .climb-visual {
      width: min(100%, 560px);
      min-height: 450px;
      padding: 26px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 8px;
      background:
        linear-gradient(140deg, rgba(27, 39, 52, 0.96), rgba(11, 15, 20, 0.96)),
        url("/images/ascend-climb-detail.jpg");
      background-size: cover;
      background-blend-mode: multiply;
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.32);
    }

    .globe-panel {
      position: relative;
      min-height: 255px;
      margin-bottom: 22px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      background:
        radial-gradient(circle at 50% 50%, rgba(87, 173, 230, 0.42), rgba(24, 73, 100, 0.34) 34%, rgba(4, 7, 11, 0.1) 69%),
        linear-gradient(150deg, rgba(22, 33, 45, 0.7), rgba(5, 8, 11, 0.85));
    }

    .globe-panel::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 290px;
      height: 290px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow:
        inset 0 0 36px rgba(180, 204, 0, 0.12),
        0 0 42px rgba(48, 122, 167, 0.22);
    }

    .pin {
      position: absolute;
      width: 16px;
      height: 16px;
      border: 2px solid #d9ef54;
      border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg);
      background: rgba(11, 15, 20, 0.82);
    }

    .pin::after {
      content: "";
      position: absolute;
      inset: 4px;
      border-radius: 50%;
      background: #d9ef54;
    }

    .pin.one {
      left: 29%;
      top: 39%;
    }

    .pin.two {
      left: 57%;
      top: 31%;
    }

    .pin.three {
      left: 69%;
      top: 57%;
    }

    .climb-card {
      position: absolute;
      left: 24px;
      right: 24px;
      bottom: 22px;
      padding: 16px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(8, 11, 16, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    .climb-card strong {
      display: block;
      margin-bottom: 3px;
      color: #fff;
      font-size: 16px;
    }

    .climb-card span {
      color: #aeb8c4;
      font-size: 13px;
    }

    .live-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .live-stat {
      padding: 14px 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
    }

    .live-stat strong {
      display: block;
      color: var(--text);
      font-size: 18px;
      line-height: 1;
    }

    .live-stat span {
      display: block;
      margin-top: 7px;
      color: #9ca7b4;
      font-size: 12px;
    }

    .best-effort-panel {
      width: min(100%, 520px);
      padding: 28px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 8px;
      background: linear-gradient(145deg, rgba(25, 31, 39, 0.98), rgba(11, 14, 19, 0.98));
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
    }

    .best-effort-hero {
      padding: 24px;
      border: 1px solid rgba(180, 204, 0, 0.25);
      border-radius: 8px;
      background: rgba(180, 204, 0, 0.09);
      text-align: center;
    }

    .wreath {
      width: 86px;
      height: 86px;
      margin: 0 auto 14px;
      object-fit: contain;
      filter: drop-shadow(0 12px 28px rgba(180, 204, 0, 0.22));
    }

    .best-effort-hero span {
      color: #b7c1cc;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .best-effort-hero strong {
      display: block;
      margin: 8px 0;
      color: var(--text);
      font-size: 30px;
      line-height: 1;
    }

    .effort-list {
      display: grid;
      gap: 12px;
      margin-top: 18px;
    }

    .effort-row {
      display: grid;
      grid-template-columns: 34px 1fr auto;
      gap: 12px;
      align-items: center;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .effort-row:last-child {
      border-bottom: 0;
    }

    .effort-rank {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
