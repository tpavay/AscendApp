---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Ascend – Stair Workout Tracker" description="Ascend is an iOS app for tracking and analyzing stair-stepper workouts. Join the waitlist to get early access.">

  <style>
    /* ── Hero Section ───────────────────────── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 120px 40px 80px;
      max-width: var(--max-width);
      margin: 0 auto;
      gap: 60px;
    }

    .hero-content {
      max-width: 540px;
    }

    .hero-content h1 {
      font-size: clamp(36px, 5vw, 60px);
      font-weight: 800;
      line-height: 1.08;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
    }

    .hero-content h1 .accent {
      color: var(--accent);
    }

    .hero-content .subtitle {
      font-size: 18px;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 32px;
    }

    /* ── Waitlist Form ──────────────────────── */
    .waitlist-form {
      display: flex;
      gap: 12px;
      margin-bottom: 16px;
    }

    .waitlist-form input {
      flex: 1;
      padding: 14px 20px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s;
    }

    .waitlist-form input::placeholder {
      color: var(--muted);
    }

    .waitlist-form input:focus {
      border-color: var(--accent);
    }

    .waitlist-form button {
      padding: 14px 28px;
      border-radius: 12px;
      border: none;
      background: var(--accent);
      color: #000;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      white-space: nowrap;
    }

    .waitlist-form button:hover {
      background: var(--accent-hover);
    }

    .waitlist-form button:active {
      transform: scale(0.98);
    }

    .waitlist-form button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .waitlist-note {
      font-size: 14px;
      color: var(--muted);
    }

    .waitlist-success {
      display: none;
      padding: 16px 20px;
      border-radius: 12px;
      background: rgba(180, 204, 0, 0.1);
      border: 1px solid rgba(180, 204, 0, 0.3);
      color: var(--accent);
      font-weight: 500;
      font-size: 15px;
    }

    .waitlist-error {
      display: none;
      padding: 12px 16px;
      border-radius: 8px;
      background: rgba(255, 80, 80, 0.1);
      border: 1px solid rgba(255, 80, 80, 0.3);
      color: #ff6b6b;
      font-size: 14px;
      margin-top: 8px;
    }

    /* ── Phone Mockup ───────────────────────── */
    .hero-phone {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .phone-frame {
      position: relative;
      width: 280px;
      height: 580px;
      border-radius: 40px;
      background: #000;
      padding: 12px;
      box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(255, 255, 255, 0.06),
        inset 0 0 0 1px rgba(255, 255, 255, 0.04);
      overflow: hidden;
    }

    .phone-frame .screen {
      width: 100%;
      height: 100%;
      border-radius: 30px;
      overflow: hidden;
      background: var(--surface);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .phone-frame .screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .phone-frame .screen video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .phone-frame .screen .placeholder {
      text-align: center;
      color: var(--muted);
      font-size: 14px;
      padding: 20px;
    }

    .phone-frame .screen .placeholder svg {
      display: block;
      margin: 0 auto 12px;
      opacity: 0.3;
    }

    /* Dynamic island notch */
    .phone-frame::before {
      content: '';
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 28px;
      background: #000;
      border-radius: 20px;
      z-index: 10;
    }

    /* ── Features Sections ──────────────────── */
    .features {
      padding: 80px 40px;
      max-width: var(--max-width);
      margin: 0 auto;
    }

    .feature-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      padding: 80px 0;
      border-top: 1px solid var(--border);
    }

    .feature-section:last-child {
      border-bottom: 1px solid var(--border);
    }

    .feature-section.reversed .feature-text {
      order: 2;
    }

    .feature-section.reversed .feature-visual {
      order: 1;
    }

    .feature-text h2 {
      font-size: clamp(28px, 3.5vw, 40px);
      font-weight: 700;
      line-height: 1.15;
      margin-bottom: 16px;
      letter-spacing: -0.01em;
    }

    .feature-text p {
      font-size: 17px;
      color: var(--muted);
      line-height: 1.7;
    }

    .feature-visual {
      display: flex;
      justify-content: center;
    }

    .feature-phone {
      width: 260px;
      height: 540px;
    }

    /* ── Screenshot Grid Section ─────────────── */
    .screenshot-grid {
      padding: 80px 40px;
      max-width: var(--max-width);
      margin: 0 auto;
      text-align: center;
    }

    .screenshot-grid h2 {
      font-size: clamp(28px, 3.5vw, 40px);
      font-weight: 700;
      margin-bottom: 16px;
    }

    .screenshot-grid .section-subtitle {
      font-size: 17px;
      color: var(--muted);
      margin-bottom: 60px;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .phone-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      justify-items: center;
    }

    .phone-grid .phone-frame {
      width: 220px;
      height: 460px;
    }

    .phone-grid .phone-frame::before {
      width: 80px;
      height: 22px;
      top: 14px;
    }

    .phone-grid .phone-frame .screen {
      border-radius: 26px;
    }

    /* ── FAQ Section ─────────────────────────── */
    .faq {
      padding: 80px 40px;
      max-width: 800px;
      margin: 0 auto;
    }

    .faq h2 {
      font-size: 40px;
      font-weight: 700;
      text-align: center;
      margin-bottom: 48px;
    }

    .faq-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 12px;
      overflow: hidden;
      background: var(--surface);
      transition: background 0.2s;
    }

    .faq-item:hover {
      background: var(--surface-hover);
    }

    .faq-question {
      width: 100%;
      background: none;
      border: none;
      color: var(--text);
      padding: 20px 24px;
      font-size: 16px;
      font-weight: 500;
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .faq-question svg {
      flex-shrink: 0;
      transition: transform 0.3s;
    }

    .faq-item.open .faq-question svg {
      transform: rotate(180deg);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .faq-answer-inner {
      padding: 0 24px 20px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.7;
    }

    /* ── CTA Section ─────────────────────────── */
    .cta-section {
      padding: 100px 40px;
      text-align: center;
      background: linear-gradient(180deg, transparent 0%, rgba(180, 204, 0, 0.03) 100%);
    }

    .cta-section h2 {
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 700;
      margin-bottom: 16px;
    }

    .cta-section p {
      font-size: 18px;
      color: var(--muted);
      margin-bottom: 36px;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-section .waitlist-form {
      max-width: 460px;
      margin: 0 auto 16px;
    }

    .cta-section .waitlist-note {
      text-align: center;
    }

    .cta-section .waitlist-success {
      max-width: 460px;
      margin: 0 auto;
    }

    .cta-section .waitlist-error {
      max-width: 460px;
      margin: 8px auto 0;
    }

    /* ── Responsive ──────────────────────────── */
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 100px 24px 60px;
        text-align: center;
        gap: 48px;
      }

      .hero-content {
        max-width: 100%;
      }

      .waitlist-form {
        flex-direction: column;
      }

      .feature-section {
        grid-template-columns: 1fr;
        gap: 40px;
        padding: 60px 0;
      }

      .feature-section.reversed .feature-text,
      .feature-section.reversed .feature-visual {
        order: unset;
      }

      .feature-text {
        text-align: center;
      }

      .phone-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }

      .phone-grid .phone-frame {
        width: 180px;
        height: 376px;
      }
    }

    @media (max-width: 600px) {
      .phone-frame {
        width: 240px;
        height: 500px;
      }

      .feature-phone {
        width: 220px;
        height: 460px;
      }

      .phone-grid {
        grid-template-columns: 1fr;
      }

      .phone-grid .phone-frame {
        width: 220px;
        height: 460px;
      }

      .features,
      .screenshot-grid,
      .faq,
      .cta-section {
        padding-left: 24px;
        padding-right: 24px;
      }
    }
  </style>

  <!-- ── Hero ────────────────────────────────── -->
  <section class="hero">
    <div class="hero-content">
      <h1>
        Climb Higher.<br />
        Track <span class="accent">Smarter.</span>
      </h1>
      <p class="subtitle">
        Ascend is an iOS app built for stair-stepper workouts. Log sessions, track detailed trends, stay consistent with streaks, compete on leaderboards, and level up your training.
      </p>

      <div id="heroWaitlist">
        <form class="waitlist-form" id="heroForm">
          <input type="email" placeholder="Enter your email" required id="heroEmail" />
          <button type="submit">Join Waitlist</button>
        </form>
        <p class="waitlist-note">Be the first to know when Ascend launches. No spam.</p>
        <div class="waitlist-success" id="heroSuccess">You're on the list! We'll be in touch.</div>
        <div class="waitlist-error" id="heroError"></div>
      </div>
    </div>

    <div class="hero-phone">
      <div class="phone-frame">
        <div class="screen">
          <img src="/images/ProgressScreen.jpg" alt="Ascend app screenshot" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Feature Sections ────────────────────── -->
  <div class="features">

    <!-- Feature 1 -->
    <section class="feature-section">
      <div class="feature-text">
        <h2>Track every step, every floor, every workout</h2>
        <p>
          Log your stair-stepper sessions with detailed stats including steps, floors, duration, and calories. See your progress at a glance with the workout calendar.
        </p>
      </div>
      <div class="feature-visual">
        <div class="phone-frame feature-phone">
          <div class="screen">
            <img src="/images/WorkoutScreen.jpg" alt="Workout tracking screen" />
          </div>
        </div>
      </div>
    </section>

    <!-- Feature 2 -->
    <section class="feature-section reversed">
      <div class="feature-text">
        <h2>Visualize your trends and personal records</h2>
        <p>
          See how your workouts stack up over time. Track personal bests, streaks, and long-term trends to keep pushing forward.
        </p>
      </div>
      <div class="feature-visual">
        <div class="phone-frame feature-phone">
          <div class="screen">
            <img src="/images/TrendsScreen.jpg" alt="Trends and analytics screen" />
          </div>
        </div>
      </div>
    </section>

    <!-- Feature 3 -->
    <section class="feature-section">
      <div class="feature-text">
        <h2>Compete with friends on the leaderboard</h2>
        <p>
          Stay motivated by climbing the ranks. See how you stack up against friends and the community on weekly and all-time leaderboards.
        </p>
      </div>
      <div class="feature-visual">
        <div class="phone-frame feature-phone">
          <div class="screen">
            <img src="/images/LeaderboardScreen.jpeg" alt="Leaderboard screen" />
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- ── Screenshot Grid ─────────────────────── -->
  <section class="screenshot-grid">
    <h2>Built for stair-stepper athletes</h2>
    <p class="section-subtitle">
      Every feature designed around the stair-stepper experience.
    </p>
    <div class="phone-grid">
      <div class="phone-frame">
        <div class="screen">
          <img src="/images/WorkoutScreen.jpg" alt="App screenshot" />
        </div>
      </div>
      <div class="phone-frame">
        <div class="screen">
          <img src="/images/ProgressScreen.jpg" alt="App screenshot" />
        </div>
      </div>
      <div class="phone-frame">
        <div class="screen">
          <img src="/images/TrendsScreen.jpg" alt="App screenshot" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ─────────────────────────────────── -->
  <section class="faq">
    <h2>FAQ</h2>

    <div class="faq-item">
      <button class="faq-question">
        What is Ascend?
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">
          Ascend is an iOS app dedicated to stair-stepper workouts. It lets you log sessions, track your progress with detailed analytics, maintain streaks, and compete with friends on leaderboards.
        </div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        When will Ascend be available?
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">
          Ascend is currently in development. Join the waitlist above to be notified as soon as it launches on the App Store.
        </div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        Is Ascend free?
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">
          Ascend will offer a free tier with core features. Premium features like advanced analytics and more will be available through an optional subscription.
        </div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        What makes Ascend different from other fitness apps?
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">
          Most fitness apps treat stair-steppers as an afterthought. Ascend is purpose-built for stair-stepper athletes with specialized tracking, trends, and a community of dedicated climbers.
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bottom CTA ──────────────────────────── -->
  <section class="cta-section">
    <h2>Ready to start climbing?</h2>
    <p>Join the waitlist and be the first to experience Ascend.</p>

    <div id="ctaWaitlist">
      <form class="waitlist-form" id="ctaForm">
        <input type="email" placeholder="Enter your email" required id="ctaEmail" />
        <button type="submit">Join Waitlist</button>
      </form>
      <p class="waitlist-note">No spam, ever. Unsubscribe anytime.</p>
      <div class="waitlist-success" id="ctaSuccess">You're on the list! We'll be in touch.</div>
      <div class="waitlist-error" id="ctaError"></div>
    </div>
  </section>

  <!-- ── Firebase SDK ────────────────────────── -->
  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.3.0/firebase-app.js';
    import { getFirestore, collection, addDoc, query, where, getDocs } from 'https://www.gstatic.com/firebasejs/11.3.0/firebase-firestore.js';

    const firebaseConfig = {
      apiKey: "AIzaSyBqLpWa9HMDa90JbFvaJFq8Azlo01lCMdI",
      authDomain: "ascend-f2e4f.firebaseapp.com",
      projectId: "ascend-f2e4f",
      storageBucket: "ascend-f2e4f.firebasestorage.app",
      messagingSenderId: "808186881002",
      appId: "1:808186881002:web:14f46f4729433b4557c893"
    };

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    async function handleWaitlist(event, formId) {
      event.preventDefault();

      const emailInput = document.getElementById(formId + 'Email');
      const form = document.getElementById(formId + 'Form');
      const successEl = document.getElementById(formId + 'Success');
      const errorEl = document.getElementById(formId + 'Error');
      const button = form?.querySelector('button');
      const email = emailInput?.value.trim().toLowerCase();

      if (!email || !button) return;

      button.disabled = true;
      button.textContent = 'Joining...';
      if (errorEl) errorEl.style.display = 'none';

      try {
        const q = query(collection(db, 'waitlist'), where('email', '==', email));
        const snapshot = await getDocs(q);

        if (!snapshot.empty) {
          if (successEl) {
            successEl.textContent = "You're already on the list! We'll be in touch.";
            successEl.style.display = 'block';
          }
          if (form) form.style.display = 'none';
          return;
        }

        await addDoc(collection(db, 'waitlist'), {
          email: email,
          source: 'landing_page',
          timestamp: new Date().toISOString(),
          createdAt: new Date()
        });

        if (form) form.style.display = 'none';
        if (successEl) successEl.style.display = 'block';
      } catch (err) {
        console.error('Waitlist error:', err);
        if (errorEl) {
          errorEl.textContent = 'Something went wrong. Please try again or email pavayt@gmail.com.';
          errorEl.style.display = 'block';
        }
        button.disabled = false;
        button.textContent = 'Join Waitlist';
      }
    }

    document.getElementById('heroForm')?.addEventListener('submit', (e) => handleWaitlist(e, 'hero'));
    document.getElementById('ctaForm')?.addEventListener('submit', (e) => handleWaitlist(e, 'cta'));
  </script>

  <!-- ── FAQ JS ────────────────────────────── -->
  <script>
    document.querySelectorAll('.faq-question').forEach(function(button) {
      button.addEventListener('click', function() {
        const item = button.parentElement;
        const answer = item?.querySelector('.faq-answer');
        const isOpen = item?.classList.contains('open');

        // Close all
        document.querySelectorAll('.faq-item').forEach(function(el) {
          el.classList.remove('open');
          const a = el.querySelector('.faq-answer');
          if (a instanceof HTMLElement) a.style.maxHeight = '';
        });

        // Open clicked if it was closed
        if (!isOpen && item && answer instanceof HTMLElement) {
          item.classList.add('open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  </script>

</BaseLayout>
