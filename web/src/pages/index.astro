---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Ascend – Stair Workout Tracker" description="Ascend is an iOS app for tracking and analyzing stair-stepper workouts. Join the waitlist to get early access.">

  <style>
    /* ── Hero Section ───────────────────────── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 120px 40px 80px;
      max-width: var(--max-width);
      margin: 0 auto;
      gap: 60px;
    }

    .hero-content {
      max-width: 540px;
    }

    .hero-content h1 {
      font-size: clamp(36px, 5vw, 60px);
      font-weight: 800;
      line-height: 1.08;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
    }

    .hero-content h1 .accent {
      color: var(--accent);
    }

    .hero-content .subtitle {
      font-size: 18px;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 32px;
    }

    /* ── Waitlist Form ──────────────────────── */
    .waitlist-form {
      display: flex;
      gap: 12px;
      margin-bottom: 16px;
    }

    .waitlist-form input {
      flex: 1;
      padding: 14px 20px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s;
    }

    .waitlist-form input.input-error {
      border-color: rgba(255, 107, 107, 0.9);
      box-shadow: 0 0 0 1px rgba(255, 107, 107, 0.25);
    }

    .waitlist-form input::placeholder {
      color: var(--muted);
    }

    .waitlist-form input:focus {
      border-color: var(--accent);
    }

    .waitlist-form button {
      padding: 14px 28px;
      border-radius: 12px;
      border: none;
      background: var(--accent);
      color: #000;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      white-space: nowrap;
    }

    .waitlist-form button:hover {
      background: var(--accent-hover);
    }

    .waitlist-form button:active {
      transform: scale(0.98);
    }

    .waitlist-form button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .waitlist-note {
      font-size: 14px;
      color: var(--muted);
    }

    .waitlist-success {
      display: none;
      position: relative;
      padding: 16px 20px 16px 56px;
      border-radius: 12px;
      border: 1px solid rgba(180, 204, 0, 0.36);
      background: linear-gradient(
        120deg,
        rgba(180, 204, 0, 0.2) 0%,
        rgba(180, 204, 0, 0.08) 55%,
        rgba(180, 204, 0, 0.12) 100%
      );
      color: #d6ed58;
      font-weight: 600;
      font-size: 15px;
      line-height: 1.45;
      overflow: hidden;
      isolation: isolate;
    }

    .waitlist-success.show {
      display: block;
      animation: waitlistReveal 0.55s cubic-bezier(0.19, 1, 0.22, 1) both;
    }

    .waitlist-success::before {
      content: "✓";
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      width: 24px;
      height: 24px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      font-size: 13px;
      font-weight: 700;
      color: #101722;
      background: linear-gradient(135deg, #d8f451 0%, #b4cc00 100%);
    }

    .waitlist-success::after {
      content: "";
      position: absolute;
      inset: -40%;
      z-index: -1;
      background: linear-gradient(
        115deg,
        transparent 35%,
        rgba(255, 255, 255, 0.32) 50%,
        transparent 65%
      );
      transform: translateX(-75%) rotate(8deg);
      opacity: 0;
    }

    .waitlist-success.is-subscribed::before {
      animation: waitlistPulse 0.9s ease-out 0.15s 1 both;
    }

    .waitlist-success.is-subscribed::after {
      opacity: 0.7;
      animation: waitlistSweep 0.9s ease-out 0.05s 1 both;
    }

    .waitlist-success.is-existing {
      border-color: rgba(125, 160, 255, 0.4);
      background: linear-gradient(
        120deg,
        rgba(95, 133, 230, 0.24) 0%,
        rgba(65, 96, 186, 0.11) 60%,
        rgba(104, 138, 225, 0.2) 100%
      );
      color: #c9dbff;
    }

    .waitlist-success.is-existing::before {
      content: "↺";
      background: linear-gradient(135deg, #a9c5ff 0%, #7fa8ff 100%);
      color: #0e1628;
    }

    .waitlist-success.is-existing::after {
      opacity: 0.45;
      animation: waitlistSweep 1.1s ease-out 0.05s 1 both;
    }

    .waitlist-burst {
      position: absolute;
      left: 30px;
      top: 50%;
      width: 0;
      height: 0;
      pointer-events: none;
      z-index: 2;
    }

    .waitlist-burst span {
      position: absolute;
      left: 0;
      top: 0;
      width: 8px;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, #efff94 0%, #b4cc00 100%);
      opacity: 0;
      transform: translate(-50%, -50%) rotate(var(--r));
      animation: waitlistParticle 0.72s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d);
    }

    @keyframes waitlistReveal {
      0% {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes waitlistPulse {
      0% {
        box-shadow: 0 0 0 0 rgba(180, 204, 0, 0.62);
      }
      100% {
        box-shadow: 0 0 0 16px rgba(180, 204, 0, 0);
      }
    }

    @keyframes waitlistSweep {
      0% {
        transform: translateX(-75%) rotate(8deg);
      }
      100% {
        transform: translateX(165%) rotate(8deg);
      }
    }

    @keyframes waitlistParticle {
      0% {
        opacity: 0;
        transform: translate(-50%, -50%) rotate(var(--r)) scale(0.2);
      }
      18% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        transform: translate(
          calc(-50% + var(--x)),
          calc(-50% + var(--y))
        ) rotate(var(--r)) scale(1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .waitlist-success.show,
      .waitlist-success.is-subscribed::before,
      .waitlist-success::after,
      .waitlist-burst span {
        animation: none !important;
      }
    }

    .waitlist-error {
      display: none;
      padding: 12px 16px;
      border-radius: 8px;
      background: rgba(255, 80, 80, 0.1);
      border: 1px solid rgba(255, 80, 80, 0.3);
      color: #ff6b6b;
      font-size: 14px;
      margin-top: 8px;
    }

    /* ── Phone Mockup ───────────────────────── */
    .hero-phone {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .phone-frame {
      position: relative;
      width: 280px;
      height: 580px;
      border-radius: 40px;
      background: #000;
      padding: 12px;
      box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(255, 255, 255, 0.06),
        inset 0 0 0 1px rgba(255, 255, 255, 0.04);
      overflow: hidden;
    }

    .phone-frame .screen {
      width: 100%;
      height: 100%;
      border-radius: 30px;
      overflow: hidden;
      background: var(--surface);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .phone-frame .screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .phone-frame .screen video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .phone-frame .screen .placeholder {
      text-align: center;
      color: var(--muted);
      font-size: 14px;
      padding: 20px;
    }

    .phone-frame .screen .placeholder svg {
      display: block;
      margin: 0 auto 12px;
      opacity: 0.3;
    }

    /* Dynamic island notch */
    .phone-frame::before {
      content: '';
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 28px;
      background: #000;
      border-radius: 20px;
      z-index: 10;
    }

    /* ── Features Sections ──────────────────── */
    .features {
      padding: 80px 40px;
      max-width: var(--max-width);
      margin: 0 auto;
    }

    .feature-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      padding: 80px 0;
      border-top: 1px solid var(--border);
    }

    .feature-section:last-child {
      border-bottom: 1px solid var(--border);
    }

    .feature-section.reversed .feature-text {
      order: 2;
    }

    .feature-section.reversed .feature-visual {
      order: 1;
    }

    .feature-text h2 {
      font-size: clamp(28px, 3.5vw, 40px);
      font-weight: 700;
      line-height: 1.15;
      margin-bottom: 16px;
      letter-spacing: -0.01em;
    }

    .feature-text p {
      font-size: 17px;
      color: var(--muted);
      line-height: 1.7;
    }

    .feature-visual {
      display: flex;
      justify-content: center;
    }

    .feature-phone {
      width: 260px;
      height: 540px;
    }

    /* ── Screenshot Grid Section ─────────────── */
    .screenshot-grid {
      padding: 80px 40px;
      max-width: var(--max-width);
      margin: 0 auto;
      text-align: center;
    }

    .screenshot-grid h2 {
      font-size: clamp(28px, 3.5vw, 40px);
      font-weight: 700;
      margin-bottom: 16px;
    }

    .screenshot-grid .section-subtitle {
      font-size: 17px;
      color: var(--muted);
      margin-bottom: 60px;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .phone-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      justify-items: center;
    }

    .phone-grid .phone-frame {
      width: 220px;
      height: 460px;
    }

    .phone-grid .phone-frame::before {
      width: 80px;
      height: 22px;
      top: 14px;
    }

    .phone-grid .phone-frame .screen {
      border-radius: 26px;
    }

    /* ── FAQ Section ─────────────────────────── */
    .faq {
      padding: 80px 40px;
      max-width: 800px;
      margin: 0 auto;
    }

    .faq h2 {
      font-size: 40px;
      font-weight: 700;
      text-align: center;
      margin-bottom: 48px;
    }

    .faq-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 12px;
      overflow: hidden;
      background: var(--surface);
      transition: background 0.2s;
    }

    .faq-item:hover {
      background: var(--surface-hover);
    }

    .faq-question {
      width: 100%;
      background: none;
      border: none;
      color: var(--text);
      padding: 20px 24px;
      font-size: 16px;
      font-weight: 500;
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .faq-question svg {
      flex-shrink: 0;
      transition: transform 0.3s;
    }

    .faq-item.open .faq-question svg {
      transform: rotate(180deg);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .faq-answer-inner {
      padding: 0 24px 20px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.7;
    }

    /* ── CTA Section ─────────────────────────── */
    .cta-section {
      padding: 100px 40px;
      text-align: center;
      background: linear-gradient(180deg, transparent 0%, rgba(180, 204, 0, 0.03) 100%);
    }

    .cta-section h2 {
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 700;
      margin-bottom: 16px;
    }

    .cta-section p {
      font-size: 18px;
      color: var(--muted);
      margin-bottom: 36px;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-section .waitlist-form {
      max-width: 460px;
      margin: 0 auto 16px;
    }

    .cta-section .waitlist-note {
      text-align: center;
    }

    .cta-section .waitlist-success {
      max-width: 460px;
      margin: 0 auto;
    }

    .cta-section .waitlist-error {
      max-width: 460px;
      margin: 8px auto 0;
    }

    /* ── Responsive ──────────────────────────── */
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 100px 24px 60px;
        text-align: center;
        gap: 48px;
      }

      .hero-content {
        max-width: 100%;
      }

      .waitlist-form {
        flex-direction: column;
      }

      .feature-section {
        grid-template-columns: 1fr;
        gap: 40px;
        padding: 60px 0;
      }

      .feature-section.reversed .feature-text,
      .feature-section.reversed .feature-visual {
        order: unset;
      }

      .feature-text {
        text-align: center;
      }

      .phone-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }

      .phone-grid .phone-frame {
        width: 180px;
        height: 376px;
      }
    }

    @media (max-width: 600px) {
      .phone-frame {
        width: 240px;
        height: 500px;
      }

      .feature-phone {
        width: 220px;
        height: 460px;
      }

      .phone-grid {
        grid-template-columns: 1fr;
      }

      .phone-grid .phone-frame {
        width: 220px;
        height: 460px;
      }

      .features,
      .screenshot-grid,
      .faq,
      .cta-section {
        padding-left: 24px;
        padding-right: 24px;
      }
    }
  </style>

  <!-- ── Hero ────────────────────────────────── -->
  <section class="hero">
    <div class="hero-content">
      <h1>
        Climb Higher.<br />
        Track <span class="accent">Smarter.</span>
      </h1>
      <p class="subtitle">
        Ascend is an iOS app built for stair-stepper workouts. Log sessions, track detailed trends, stay consistent with streaks, compete on leaderboards, and level up your training.
      </p>

      <div id="heroWaitlist">
        <form class="waitlist-form" id="heroForm">
          <input type="email" placeholder="Enter your email" required id="heroEmail" autocomplete="email" inputmode="email" />
          <button type="submit">Join Waitlist</button>
        </form>
        <p class="waitlist-note">Be the first to know when Ascend launches. No spam.</p>
        <div class="waitlist-success" id="heroSuccess" role="status" aria-live="polite">You're on the list! We'll be in touch.</div>
        <div class="waitlist-error" id="heroError"></div>
      </div>
    </div>

    <div class="hero-phone">
      <div class="phone-frame">
        <div class="screen">
          <img src="/images/ProgressScreen.jpg" alt="Ascend app screenshot" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Feature Sections ────────────────────── -->
  <div class="features">

    <!-- Feature 1 -->
    <section class="feature-section">
      <div class="feature-text">
        <h2>Track every step, every floor, every workout</h2>
        <p>
          Log your stair-stepper sessions with detailed stats including steps, floors, duration, and calories. See your progress at a glance with the workout calendar.
        </p>
      </div>
      <div class="feature-visual">
        <div class="phone-frame feature-phone">
          <div class="screen">
            <img src="/images/WorkoutScreen.jpg" alt="Workout tracking screen" />
          </div>
        </div>
      </div>
    </section>

    <!-- Feature 2 -->
    <section class="feature-section reversed">
      <div class="feature-text">
        <h2>Visualize your trends and personal records</h2>
        <p>
          See how your workouts stack up over time. Track personal bests, streaks, and long-term trends to keep pushing forward.
        </p>
      </div>
      <div class="feature-visual">
        <div class="phone-frame feature-phone">
          <div class="screen">
            <img src="/images/TrendsScreen.jpg" alt="Trends and analytics screen" />
          </div>
        </div>
      </div>
    </section>

    <!-- Feature 3 -->
    <section class="feature-section">
      <div class="feature-text">
        <h2>Compete with friends on the leaderboard</h2>
        <p>
          Stay motivated by climbing the ranks. See how you stack up against friends and the community on weekly and all-time leaderboards.
        </p>
      </div>
      <div class="feature-visual">
        <div class="phone-frame feature-phone">
          <div class="screen">
            <img src="/images/LeaderboardScreen.jpeg" alt="Leaderboard screen" />
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- ── Screenshot Grid ─────────────────────── -->
  <section class="screenshot-grid">
    <h2>Built for stair-stepper athletes</h2>
    <p class="section-subtitle">
      Every feature designed around the stair-stepper experience.
    </p>
    <div class="phone-grid">
      <div class="phone-frame">
        <div class="screen">
          <img src="/images/WorkoutScreen.jpg" alt="App screenshot" />
        </div>
      </div>
      <div class="phone-frame">
        <div class="screen">
          <img src="/images/ProgressScreen.jpg" alt="App screenshot" />
        </div>
      </div>
      <div class="phone-frame">
        <div class="screen">
          <img src="/images/TrendsScreen.jpg" alt="App screenshot" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ─────────────────────────────────── -->
  <section class="faq">
    <h2>FAQ</h2>

    <div class="faq-item">
      <button class="faq-question">
        What is Ascend?
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">
          Ascend is an iOS app dedicated to stair-stepper workouts. It lets you log sessions, track your progress with detailed analytics, maintain streaks, and compete with friends on leaderboards.
        </div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        When will Ascend be available?
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">
          Ascend is currently in development. Join the waitlist above to be notified as soon as it launches on the App Store.
        </div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        Is Ascend free?
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">
          Ascend will offer a free tier with core features. Premium features like advanced analytics and more will be available through an optional subscription.
        </div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        What makes Ascend different from other fitness apps?
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">
          Most fitness apps treat stair-steppers as an afterthought. Ascend is purpose-built for stair-stepper athletes with specialized tracking, trends, and a community of dedicated climbers.
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bottom CTA ──────────────────────────── -->
  <section class="cta-section">
    <h2>Ready to start climbing?</h2>
    <p>Join the waitlist and be the first to experience Ascend.</p>

    <div id="ctaWaitlist">
      <form class="waitlist-form" id="ctaForm">
        <input type="email" placeholder="Enter your email" required id="ctaEmail" autocomplete="email" inputmode="email" />
        <button type="submit">Join Waitlist</button>
      </form>
      <p class="waitlist-note">No spam, ever. Unsubscribe anytime.</p>
      <div class="waitlist-success" id="ctaSuccess" role="status" aria-live="polite">You're on the list! We'll be in touch.</div>
      <div class="waitlist-error" id="ctaError"></div>
    </div>
  </section>

  <!-- ── Waitlist Submit Logic ───────────────── -->
  <script type="module">
    const WAITLIST_ENDPOINT = '/api/join-waitlist';
    const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function triggerWaitlistBurst(successEl) {
      successEl.querySelectorAll('.waitlist-burst').forEach((el) => el.remove());

      const burst = document.createElement('span');
      burst.className = 'waitlist-burst';

      for (let i = 0; i < 12; i++) {
        const particle = document.createElement('span');
        const angle = (Math.PI * 2 * i) / 12 + (Math.random() - 0.5) * 0.25;
        const distance = 24 + Math.random() * 24;
        const driftX = Math.cos(angle) * distance;
        const driftY = Math.sin(angle) * distance;
        const rotation = (Math.random() - 0.5) * 80;

        particle.style.setProperty('--x', `${driftX.toFixed(2)}px`);
        particle.style.setProperty('--y', `${driftY.toFixed(2)}px`);
        particle.style.setProperty('--r', `${rotation.toFixed(0)}deg`);
        particle.style.setProperty('--d', `${Math.round(Math.random() * 90)}ms`);
        burst.appendChild(particle);
      }

      successEl.appendChild(burst);
      window.setTimeout(() => burst.remove(), 900);
    }

    function showWaitlistSuccess(successEl, status) {
      if (!successEl) return;

      const isExisting = status === 'already_subscribed';
      successEl.textContent = isExisting
        ? "You're already on the list. We'll be in touch."
        : "You're in! We'll let you know when Ascend is live.";

      successEl.classList.remove('show', 'is-subscribed', 'is-existing');
      void successEl.offsetWidth;
      successEl.classList.add('show', isExisting ? 'is-existing' : 'is-subscribed');

      if (!isExisting) {
        triggerWaitlistBurst(successEl);
      }
    }

    async function handleWaitlist(event, formId) {
      event.preventDefault();

      const waitlistRoot = document.getElementById(formId + 'Waitlist');
      const emailInput = document.getElementById(formId + 'Email');
      const form = document.getElementById(formId + 'Form');
      const noteEl = waitlistRoot?.querySelector('.waitlist-note');
      const successEl = document.getElementById(formId + 'Success');
      const errorEl = document.getElementById(formId + 'Error');
      const button = form?.querySelector('button');
      const email = emailInput?.value.trim().toLowerCase();

      if (!email || !button) return;

      if (emailInput instanceof HTMLInputElement) {
        emailInput.classList.remove('input-error');
      }

      const showError = (message, isValidation = false) => {
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.style.display = 'block';
        }
        if (noteEl instanceof HTMLElement) noteEl.style.display = '';
        if (isValidation && emailInput instanceof HTMLInputElement) {
          emailInput.classList.add('input-error');
          emailInput.focus();
        }
      };

      if (!EMAIL_PATTERN.test(email)) {
        showError('Please enter a valid email address.', true);
        return;
      }

      button.disabled = true;
      button.textContent = 'Joining...';
      if (errorEl) errorEl.style.display = 'none';

      try {
        const response = await fetch(WAITLIST_ENDPOINT, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email: email,
            source: 'landing_page'
          })
        });

        let payload = null;
        try {
          payload = await response.json();
        } catch {
          payload = null;
        }

        if (!response.ok) {
          if (payload?.error === 'invalid_email') {
            showError('Please enter a valid email address.', true);
            button.disabled = false;
            button.textContent = 'Join Waitlist';
            return;
          }
          throw new Error(typeof payload?.error === 'string' ? payload.error : 'waitlist_request_failed');
        }

        showWaitlistSuccess(successEl, payload?.status);

        if (form) form.style.display = 'none';
        if (noteEl instanceof HTMLElement) noteEl.style.display = 'none';
      } catch (err) {
        console.error('Waitlist error:', err);
        showError('Something went wrong. Please try again or email pavayt@gmail.com.');
        button.disabled = false;
        button.textContent = 'Join Waitlist';
      }
    }

    function clearWaitlistValidation(formId) {
      const emailInput = document.getElementById(formId + 'Email');
      const errorEl = document.getElementById(formId + 'Error');
      if (!(emailInput instanceof HTMLInputElement)) return;

      emailInput.addEventListener('input', () => {
        emailInput.classList.remove('input-error');
        if (errorEl instanceof HTMLElement && errorEl.style.display === 'block') {
          errorEl.style.display = 'none';
        }
      });
    }

    document.getElementById('heroForm')?.addEventListener('submit', (e) => handleWaitlist(e, 'hero'));
    document.getElementById('ctaForm')?.addEventListener('submit', (e) => handleWaitlist(e, 'cta'));
    clearWaitlistValidation('hero');
    clearWaitlistValidation('cta');
  </script>

  <!-- ── FAQ JS ────────────────────────────── -->
  <script>
    document.querySelectorAll('.faq-question').forEach(function(button) {
      button.addEventListener('click', function() {
        const item = button.parentElement;
        const answer = item?.querySelector('.faq-answer');
        const isOpen = item?.classList.contains('open');

        // Close all
        document.querySelectorAll('.faq-item').forEach(function(el) {
          el.classList.remove('open');
          const a = el.querySelector('.faq-answer');
          if (a instanceof HTMLElement) a.style.maxHeight = '';
        });

        // Open clicked if it was closed
        if (!isOpen && item && answer instanceof HTMLElement) {
          item.classList.add('open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  </script>

</BaseLayout>
