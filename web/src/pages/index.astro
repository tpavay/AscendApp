---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import { APP_STORE_URL } from '../appStore';
---
<BaseLayout title="Ascend - Stair Stepper Racing" description="Compete on the stair stepper. Your headphones count every step, and Ascend turns every one of them into a race against other climbers.">

  <style>
    .wrap {
      width: min(100%, 1160px);
      margin: 0 auto;
      padding: 0 40px;
    }

    .section {
      padding: 120px 0;
      overflow-x: clip;
    }

    .act {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .act.lime {
      color: var(--accent);
    }

    .accent {
      color: var(--accent);
    }

    .muted {
      color: var(--muted);
    }

    h1.display {
      font-size: clamp(44px, 5.4vw, 76px);
      font-weight: 850;
      line-height: 1.02;
      letter-spacing: -0.01em;
    }

    h2.display {
      font-size: clamp(34px, 4vw, 56px);
      font-weight: 850;
      line-height: 1.05;
      letter-spacing: -0.01em;
    }

    .lead {
      font-size: 20px;
      line-height: 1.55;
      color: #c9d1d9;
    }

    .actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .trial {
      font-size: 14px;
      color: var(--muted);
    }

    /* Hero: gym footage behind the line, so the first screen shows the machine itself. */
    .hero {
      position: relative;
      min-height: 100vh;
      display: grid;
      place-items: center;
      overflow: hidden;
      text-align: center;
      padding: 120px 24px 80px;
      background: #090d12;
    }

    .hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
      filter: brightness(0.42) saturate(0.9);
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        radial-gradient(ellipse at 50% 45%, rgba(9, 13, 18, 0.25), rgba(9, 13, 18, 0.85) 75%),
        linear-gradient(transparent 70%, var(--bg));
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 900px;
    }

    .hero h1 {
      margin-bottom: 20px;
    }

    .hero .lead {
      max-width: 640px;
      margin: 0 auto 32px;
    }

    .watch {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      height: 48px;
      padding: 0 22px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: var(--text);
      background: rgba(255, 255, 255, 0.06);
      font: inherit;
      font-weight: 700;
      font-size: 16px;
      cursor: pointer;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .watch:hover {
      background: rgba(255, 255, 255, 0.12);
    }

    .watch svg {
      width: 16px;
      height: 16px;
    }

    /* The problem */
    .problem {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: center;
    }

    .problem-photo {
      border-radius: 26px;
      overflow: hidden;
      aspect-ratio: 4 / 5;
    }

    .problem-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: grayscale(0.85) brightness(0.75);
    }

    .problem h2 {
      margin: 14px 0 20px;
    }

    /* The fix */
    .fix {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 72px;
      align-items: center;
    }

    .fix-visual {
      position: relative;
      display: grid;
      place-items: center;
    }

    .glow {
      position: absolute;
      width: 640px;
      height: 640px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(134, 211, 10, 0.28), rgba(134, 211, 10, 0) 65%);
      filter: blur(10px);
      pointer-events: none;
    }

    .fix h2 {
      margin-top: 14px;
    }

    .beats {
      margin-top: 30px;
      border-top: 1px solid var(--border);
    }

    .beat {
      position: relative;
      padding: 20px 0 20px 22px;
      border-bottom: 1px solid var(--border);
    }

    .beat::before {
      content: "";
      position: absolute;
      left: 0;
      top: 24px;
      bottom: 24px;
      width: 3px;
      border-radius: 2px;
      background: var(--accent);
    }

    .beat h3 {
      font-size: 22px;
      font-weight: 800;
      line-height: 1.3;
    }

    .beat p {
      color: var(--muted);
      margin-top: 4px;
    }

    /* Phones: real captures of the app in a plain device outline. */
    .phone {
      position: relative;
      width: 300px;
      aspect-ratio: 1179 / 2556;
      border-radius: 46px;
      padding: 10px;
      background: #050607;
      box-shadow:
        0 0 0 1.5px rgba(255, 255, 255, 0.14),
        0 40px 90px rgba(0, 0, 0, 0.6),
        0 0 120px rgba(134, 211, 10, 0.12);
    }

    .phone .screen {
      width: 100%;
      height: 100%;
      border-radius: 37px;
      overflow: hidden;
      background: #000;
    }

    .phone .screen img,
    .phone .screen video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .phone.large {
      width: 340px;
    }

    .phone.small {
      width: 240px;
      border-radius: 38px;
      padding: 8px;
    }

    .phone.small .screen {
      border-radius: 31px;
    }

    /* The prize */
    .prize {
      text-align: center;
    }

    .prize h2 {
      margin-top: 14px;
    }

    .prize .lead {
      max-width: 640px;
      margin: 16px auto 0;
    }

    .crowns {
      display: flex;
      justify-content: center;
      gap: 36px;
      flex-wrap: wrap;
      margin-top: 40px;
    }

    .crown img {
      width: 150px;
      display: block;
      margin: 0 auto 6px;
      filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.6));
    }

    .crown span {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.14em;
      color: var(--muted);
    }

    .gallery {
      display: flex;
      justify-content: center;
      align-items: flex-end;
      gap: 26px;
      margin-top: 56px;
    }

    .gallery .phone:nth-child(2) {
      transform: translateY(-28px);
    }

    /* FAQ */
    .faq {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .faq h2 {
      margin-bottom: 42px;
      text-align: center;
      font-size: clamp(32px, 4vw, 46px);
      font-weight: 850;
      letter-spacing: 0;
    }

    .faq-item {
      margin-bottom: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.045);
      transition: background 0.2s;
    }

    .faq-item:hover {
      background: rgba(255, 255, 255, 0.065);
    }

    .faq-question {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 20px 22px;
      border: 0;
      background: none;
      color: var(--text);
      font: inherit;
      font-size: 16px;
      font-weight: 750;
      text-align: left;
      cursor: pointer;
    }

    .faq-question svg {
      flex-shrink: 0;
      transition: transform 0.3s;
    }

    .faq-item.open .faq-question svg {
      transform: rotate(180deg);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .faq-answer-inner {
      padding: 0 22px 20px;
      color: #a8b2bf;
      font-size: 15px;
      line-height: 1.7;
    }

    /* Closing call to action */
    .cta {
      text-align: center;
      padding: 130px 40px;
      background:
        radial-gradient(ellipse at 50% 120%, rgba(134, 211, 10, 0.35), rgba(13, 17, 23, 0) 60%),
        var(--bg);
    }

    .cta .actions {
      margin-top: 30px;
    }

    .cta .trial {
      margin-top: 14px;
    }

    /* The full story, played in place on demand. */
    .player {
      /* The global reset zeroes every margin, and a modal dialog centres itself with margin: auto. */
      margin: auto;
      border: 0;
      padding: 0;
      background: transparent;
      width: min(92vw, 1100px);
      overflow: visible;
    }

    .player::backdrop {
      background: rgba(0, 0, 0, 0.85);
    }

    .player video {
      width: 100%;
      border-radius: 16px;
      display: block;
    }

    .player-close {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 1;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.28);
      background: rgba(0, 0, 0, 0.55);
      color: var(--text);
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
    }

    @media (max-width: 900px) {
      .wrap,
      .faq {
        padding: 0 20px;
      }

      .section {
        padding: 80px 0;
      }

      .problem,
      .fix {
        grid-template-columns: 1fr;
        gap: 36px;
      }

      .phone.large {
        width: 280px;
      }

      .gallery {
        flex-direction: column;
        align-items: center;
      }

      .gallery .phone:nth-child(2) {
        transform: none;
      }

      .cta {
        padding: 96px 20px;
      }
    }

    @media (max-width: 760px) {
      .lead {
        font-size: 17px;
      }
    }
  </style>

  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/home/stair-stepper-hero.jpg" aria-hidden="true">
      <source src="/images/home/stair-stepper-hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-inner">
      <h1 class="display">Compete on <span class="accent">the stair stepper.</span></h1>
      <p class="lead">Your headphones count every step. Ascend turns every one of them into a race against other climbers.</p>
      <div class="actions">
        <AppStoreBadge href={APP_STORE_URL} />
        <button class="watch" id="watch-story" type="button">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" /></svg>
          Watch the 1-minute story
        </button>
      </div>
    </div>
  </section>

  <section class="section" id="why">
    <div class="wrap problem">
      <div class="problem-photo">
        <img src="/images/home/stair-stepper-gym.jpg" alt="A row of stair steppers in a gym, seen from the floor" loading="lazy" decoding="async" />
      </div>
      <div>
        <div class="act">The problem</div>
        <h2 class="display">The hardest machine in the gym. <span class="muted">And the most boring.</span></h2>
        <p class="lead">Forty minutes, one console, the same numbers ticking up. Nobody to chase and nothing to win.</p>
      </div>
    </div>
  </section>

  <section class="section" id="how-it-works" style="padding-top: 20px;">
    <div class="wrap fix">
      <div class="fix-visual">
        <div class="glow"></div>
        <div class="phone large">
          <div class="screen">
            <video autoplay muted loop playsinline preload="metadata" poster="/images/home/ascend-mountain-race.jpg" aria-label="Ascend Mountain: an athlete climbing the stairs with other climbers">
              <source src="/images/home/ascend-mountain-race.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </div>
      <div>
        <div class="act lime">The fix</div>
        <h2 class="display">Ascend turns it <span class="accent">into a race.</span></h2>
        <div class="beats">
          <div class="beat">
            <h3>Your headphones count every step</h3>
            <p>AirPods or Beats track every step automatically. Nothing to log.</p>
          </div>
          <div class="beat">
            <h3>You race other climbers</h3>
            <p>Every step moves your athlete up the stairs, past other climbers' best climbs, step for step.</p>
          </div>
          <div class="beat">
            <h3>You climb the leaderboard</h3>
            <p>Win the week, the month or the year, and wear the crown everyone sees.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="compete" style="padding-top: 20px;">
    <div class="wrap prize">
      <div class="act lime">The prize</div>
      <h2 class="display">Chase the crown.</h2>
      <p class="lead">Weekly, monthly, yearly and all-time champions wear their crown on every board in the app.</p>
      <div class="crowns">
        <div class="crown"><img src="/images/home/crown-weekly-gold.png" alt="" loading="lazy" decoding="async" /><span>WEEKLY</span></div>
        <div class="crown"><img src="/images/home/crown-monthly-diamond.png" alt="" loading="lazy" decoding="async" /><span>MONTHLY</span></div>
        <div class="crown"><img src="/images/home/crown-yearly-ruby.png" alt="" loading="lazy" decoding="async" /><span>YEARLY</span></div>
        <div class="crown"><img src="/images/home/crown-alltime-mythic.png" alt="" loading="lazy" decoding="async" /><span>ALL TIME</span></div>
      </div>
      <div class="gallery">
        <div class="phone small"><div class="screen"><img src="/images/home/app-race.jpg" alt="An Ascend Mountain race, fifth of 412 climbers" loading="lazy" decoding="async" /></div></div>
        <div class="phone"><div class="screen"><img src="/images/home/app-leaderboard.jpg" alt="The weekly leaderboard with last week's champion" loading="lazy" decoding="async" /></div></div>
        <div class="phone small"><div class="screen"><img src="/images/home/app-globe.jpg" alt="Climbs around the globe on the Home screen" loading="lazy" decoding="async" /></div></div>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="faq">
      <h2>FAQ</h2>

      <div class="faq-item">
        <button class="faq-question">
          What is Ascend?
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            Ascend is a stair stepper racing app for iOS. You pick a real tower, such as the Empire State Building, Taipei 101, or the Eiffel Tower, and race its actual step count on the machine in front of you, against every climber who has taken it on. Your rank, your records, and your history all come out of the races you run.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          What are Live Climbs?
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            A Live Climb is one race up one tower. Ascend counts your steps in real time from compatible headphone motion, ranks you against the attempts already posted on that tower, and gives you a completion summary, splits, and leaderboard context when you finish.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          How does Ascend count my steps during a race?
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            Ascend reads the motion in your AirPods or compatible headphones and runs a stair-stepper-tuned step algorithm in real time. Your steps, pace, and rank update every second as you climb. It measures your actual movement, so the count stays accurate as long as you&rsquo;re climbing. Stop stepping and it stops counting, exactly as it should.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          What do I need to race?
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            A stair stepper and a pair of motion-equipped AirPods or Beats. That is the whole kit. A Bluetooth chest strap is optional and adds live heart rate and effort zones while you climb.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          Does Ascend work with Apple Health?
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            For heart rate, yes. Connect Apple Health and Ascend attaches the heart-rate data recorded while you were racing to that climb, so an Apple Watch or any wearable that writes to Apple Health can supply it. Ascend does not import workouts from Apple Health, and there is no manual workout entry. Every record in Ascend comes from a climb you performed in Ascend.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          Is Ascend free?
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            No. Ascend is a subscription. Start with a 7-day free trial on the $49.99/year plan. The $9.99/month plan is charged immediately and has no trial. Cancel anytime.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          Where do I get Ascend?
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            Ascend is out now on the App Store for iPhone. Download it, pick a tower, and start the race.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta" id="download">
    <h2 class="display">Make the stair stepper <span class="accent">a race.</span></h2>
    <div class="actions">
      <AppStoreBadge href={APP_STORE_URL} />
    </div>
    <p class="trial">7-day free trial on the yearly plan. iPhone only.</p>
  </section>

  <dialog class="player" id="story-player" aria-label="The Ascend story">
    <button class="player-close" id="close-story" type="button" aria-label="Close video">&times;</button>
    <video controls playsinline preload="none" poster="/images/home/ascend-story.jpg">
      <source src="/images/home/ascend-story.mp4" type="video/mp4" />
    </video>
  </dialog>

  <script>
    document.querySelectorAll('.faq-question').forEach(function(button) {
      button.addEventListener('click', function() {
        const item = button.parentElement;
        const answer = item?.querySelector('.faq-answer');
        const isOpen = item?.classList.contains('open');

        document.querySelectorAll('.faq-item').forEach(function(el) {
          el.classList.remove('open');
          const a = el.querySelector('.faq-answer');
          if (a instanceof HTMLElement) a.style.maxHeight = '';
        });

        if (!isOpen && item && answer instanceof HTMLElement) {
          item.classList.add('open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });

    const player = document.getElementById('story-player');
    const story = player?.querySelector('video');
    if (player instanceof HTMLDialogElement && story instanceof HTMLVideoElement) {
      document.getElementById('watch-story')?.addEventListener('click', function() {
        player.showModal();
        story.play().catch(function() {});
      });
      document.getElementById('close-story')?.addEventListener('click', function() {
        player.close();
      });
      // A click on the backdrop lands on the dialog itself.
      player.addEventListener('click', function(event) {
        if (event.target === player) player.close();
      });
      player.addEventListener('close', function() {
        story.pause();
      });
    }

    // Decorative loops stand still for anyone who asked the system for less motion.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('video[autoplay]').forEach(function(video) {
        if (video instanceof HTMLVideoElement) {
          video.removeAttribute('autoplay');
          video.pause();
        }
      });
    }
  </script>

</BaseLayout>
